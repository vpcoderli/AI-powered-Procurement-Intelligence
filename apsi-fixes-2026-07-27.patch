index 0000000..03f6af4
--- /dev/null
+++ b/frontend/scripts/worker-shutdown.ts
@@ -0,0 +1,107 @@
+/**
+ * Cooperative, interruptible shutdown handling shared by the three long-running
+ * worker scripts (`crawler-worker.ts`, `event-worker.ts`, `notification-worker.ts`).
+ *
+ * Why this exists: each worker used to sleep between ticks with a bare
+ * `setTimeout` and flip a `stopping` boolean from its SIGINT/SIGTERM handler.
+ * Flipping the boolean does not interrupt an in-flight `setTimeout`, so with the
+ * default 15 minute tick interval a worker that received SIGTERM kept sleeping for
+ * up to 15 more minutes. ECS `StopTimeout` defaults to 30s, so every deploy ended
+ * in SIGKILL and the `finally` block that closes the MySQL pool / SQLite handle
+ * never ran.
+ *
+ * `sleep()` here is backed by an `AbortSignal`, so a shutdown request resolves the
+ * pending sleep immediately and the loop reaches its `finally` within the stop
+ * timeout.
+ */
+
+export interface WorkerShutdownProcess {
+  once(event: string, listener: () => void): unknown;
+  off(event: string, listener: () => void): unknown;
+}
+
+export interface WorkerShutdownController {
+  /** Aborts as soon as shutdown is requested; pass to abortable async work. */
+  readonly signal: AbortSignal;
+  /** True once a shutdown signal has been received (or `stop()` was called). */
+  readonly stopping: boolean;
+  /** Resolves after `ms`, or immediately once shutdown is requested. */
+  sleep(ms: number): Promise<void>;
+  /** Requests shutdown explicitly (used by tests and by `--run-once` style exits). */
+  stop(): void;
+  /** Detaches the installed process signal listeners. */
+  dispose(): void;
+}
+
+export interface CreateWorkerShutdownControllerOptions {
+  /** Defaults to SIGINT + SIGTERM, the two signals ECS/Docker send on stop. */
+  signals?: string[];
+  /** Injectable for tests; defaults to the real `process`. */
+  processRef?: WorkerShutdownProcess;
+}
+
+const DEFAULT_SHUTDOWN_SIGNALS = ["SIGINT", "SIGTERM"];
+
+/**
+ * `setTimeout` that also settles when `signal` aborts. Never rejects: callers use
+ * this purely as a pause between ticks, and an aborted sleep is a normal shutdown,
+ * not an error.
+ */
+export function interruptibleSleep(ms: number, signal: AbortSignal): Promise<void> {
+  if (signal.aborted) return Promise.resolve();
+
+  return new Promise<void>((resolve) => {
+    const onAbort = () => {
+      clearTimeout(timer);
+      resolve();
+    };
+
+    const timer = setTimeout(() => {
+      signal.removeEventListener("abort", onAbort);
+      resolve();
+    }, ms);
+
+    signal.addEventListener("abort", onAbort, { once: true });
+  });
+}
+
+export function createWorkerShutdownController(
+  options: CreateWorkerShutdownControllerOptions = {},
+): WorkerShutdownController {
+  const signals = options.signals ?? DEFAULT_SHUTDOWN_SIGNALS;
+  const processRef = options.processRef ?? (process as unknown as WorkerShutdownProcess);
+  const controller = new AbortController();
+  const listeners = new Map<string, () => void>();
+
+  const stop = () => {
+    if (!controller.signal.aborted) {
+      controller.abort();
+    }
+  };
+
+  const dispose = () => {
+    for (const [signalName, listener] of listeners) {
+      processRef.off(signalName, listener);
+    }
+    listeners.clear();
+  };
+
+  for (const signalName of signals) {
+    const listener = () => {
+      listeners.delete(signalName);
+      stop();
+    };
+    listeners.set(signalName, listener);
+    processRef.once(signalName, listener);
+  }
+
+  return {
+    signal: controller.signal,
+    get stopping() {
+      return controller.signal.aborted;
+    },
+    sleep: (ms: number) => interruptibleSleep(ms, controller.signal),
+    stop,
+    dispose,
+  };
+}

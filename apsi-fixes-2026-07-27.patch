@@ -0,0 +1,54 @@
+import { NextResponse } from "next/server";
+
+/**
+ * Request body size ceiling for App Router route handlers.
+ *
+ * Next.js's own body limits (`experimental.serverActions.bodySizeLimit`,
+ * `experimental.proxyClientMaxBodySize` in `frontend/next.config.ts`) cover
+ * Server Actions and the proxy layer — they do NOT bound a Route Handler that
+ * calls `request.formData()` / `request.arrayBuffer()`, which buffers the
+ * entire body into process memory. Upload routes therefore have to check for
+ * themselves, before touching the body.
+ *
+ * The check is header-based, so it is a fast cheap rejection, not a hard
+ * guarantee: a caller can omit `Content-Length` (chunked transfer) and slip
+ * past it. The authoritative limit remains `MAX_FILE_BYTES` in
+ * `@/server/artifacts/service`, which runs after parsing. What this adds is
+ * that the common case — an oversized upload announced honestly by the client
+ * — costs the server nothing.
+ */
+
+/** 25MB artifact ceiling plus slack for multipart boundaries and fields. */
+export const MAX_UPLOAD_REQUEST_BYTES = 30 * 1024 * 1024;
+
+export function requestContentLength(request: Request): number | null {
+  const raw = request.headers.get("content-length");
+  if (!raw) return null;
+
+  const parsed = Number.parseInt(raw.trim(), 10);
+  return Number.isFinite(parsed) && parsed >= 0 ? parsed : null;
+}
+
+/**
+ * Returns true when the request declares a body larger than `maxBytes`.
+ * A missing or unparseable `Content-Length` returns false (inconclusive).
+ */
+export function exceedsRequestBodyLimit(
+  request: Request,
+  maxBytes: number = MAX_UPLOAD_REQUEST_BYTES,
+): boolean {
+  const contentLength = requestContentLength(request);
+  return contentLength !== null && contentLength > maxBytes;
+}
+
+export function payloadTooLargeResponse(maxBytes: number = MAX_UPLOAD_REQUEST_BYTES) {
+  return NextResponse.json(
+    {
+      error: {
+        code: "PAYLOAD_TOO_LARGE",
+        message: `Request body exceeds the ${Math.floor(maxBytes / (1024 * 1024))}MB upload limit.`,
+      },
+    },
+    { status: 413 },
+  );
+}

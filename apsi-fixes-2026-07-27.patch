+  // Extra origins the browser may talk to (Sentry ingest, analytics, an API
+  // subdomain). Comma or space separated, e.g.
+  // `CSP_CONNECT_SRC="https://o123.ingest.sentry.io"`.
+  const extraConnectSrc = (process.env.CSP_CONNECT_SRC ?? "")
+    .split(/[,\s]+/)
+    .map((value) => value.trim())
+    .filter(Boolean);

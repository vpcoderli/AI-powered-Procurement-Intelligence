+ * documented in `docs/operations/aws-deployment-runbook.md`) therefore put the
+ * real client IP at the RIGHT-hand end, not the left. Reading the leftmost
+ * entry means reading a value the client itself supplied — an attacker sends
+ * `X-Forwarded-For: <random>` and gets a brand-new rate-limit bucket per
+ * request, which disables login/password-reset throttling entirely.
+ *
+ * So we count in from the right by the number of proxies we actually trust
+ * (`TRUSTED_PROXY_HOP_COUNT`, default 1 for a single ALB in front of the app).
+ * With `a, b, c` and one trusted hop, `c` was written by our own load
+ * balancer and is the address it saw, so `c` is the client. Any entries to the
+ * left of that are client-controlled and ignored.
+ *
+ * Set `TRUSTED_PROXY_HOP_COUNT=2` when an additional trusted proxy (e.g.
+ * CloudFront in front of the ALB) appends another hop. Setting it higher than
+ * the real hop count is the unsafe direction — it walks left into
+ * attacker-controlled entries — so we clamp to the available entries and never
+ * go further left than the first one.
+ *
+ * Falls back to `x-real-ip` and then to a constant so unauthenticated rate
+ * limiting degrades to a single shared bucket rather than throwing when
+ * headers are absent (e.g. in tests or direct local requests).
  */
+
+const DEFAULT_TRUSTED_PROXY_HOP_COUNT = 1;
+
+export function trustedProxyHopCount(env: Record<string, string | undefined> = process.env): number {
+  const raw = env.TRUSTED_PROXY_HOP_COUNT?.trim();
+  if (!raw) return DEFAULT_TRUSTED_PROXY_HOP_COUNT;
+
+  const parsed = Number.parseInt(raw, 10);
+  if (!Number.isFinite(parsed) || parsed < 1) return DEFAULT_TRUSTED_PROXY_HOP_COUNT;
+
+  return parsed;

+  // No allowlisted extension: only honour a stored value if it is itself an
+  // allowlisted type (e.g. the plain-text notes this app generates itself).
+  const stored = storedContentType?.trim().toLowerCase();
+  if (stored && Object.values(CONTENT_TYPE_BY_EXTENSION).some((value) => value.toLowerCase() === stored)) {
+    return stored;
+  }
+
+  return DEFAULT_BINARY_CONTENT_TYPE;
+}

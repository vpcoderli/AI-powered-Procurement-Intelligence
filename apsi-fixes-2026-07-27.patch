+    expect(response.bids).toHaveLength(6);
+    expect(response.totalPages).toBe(1);
+    expect(response.hasMore).toBe(false);
+  });
+
+  it("counts every match while returning only one page of rows", async () => {
+    const firstPage = await queryBidsFromDatabase(
+      testDb.db,

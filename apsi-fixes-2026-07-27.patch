+function fakeLegacyBillingPool(
+  columnType: string,
+  options: { duplicateRows?: number } = {},
+): FakeLegacyBillingPool {
+  const statements: string[] = [];
+  let currentType = columnType;
+  let duplicateRows = options.duplicateRows ?? 0;
+
+  const query = async (sql: string) => {
+    statements.push(sql);
+    const trimmed = sql.trim();
+
+    if (trimmed.startsWith("SHOW TABLES LIKE")) return [[{ table: "subscription_events" }], undefined];
+    if (trimmed.startsWith("SHOW COLUMNS FROM subscription_events")) {
+      return [[{ Field: "provider_event_id", Type: currentType }], undefined];
+    }
+    if (trimmed.startsWith("SHOW COLUMNS FROM")) return [[{ Field: "already_there" }], undefined];
+    if (trimmed.includes("MODIFY COLUMN provider_event_id")) {
+      currentType = "varchar(191)";
+      return [{ affectedRows: 0 }, undefined];
+    }
+    if (trimmed.startsWith("DELETE older FROM subscription_events")) {
+      const affectedRows = duplicateRows;
+      duplicateRows = 0;
+      return [{ affectedRows }, undefined];
+    }
+    if (trimmed.startsWith("CREATE UNIQUE INDEX") && trimmed.includes("provider_event_id") && duplicateRows > 0) {
+      throw Object.assign(new Error("fake ER_DUP_ENTRY"), { code: "ER_DUP_ENTRY" });
+    }
+
+    return [[], undefined];
+  };
+
+  return { pool: { query } as unknown as Pool, statements };
+}

+  it("resolves immediately when the signal is already aborted", async () => {
+    const controller = new AbortController();
+    controller.abort();
+
+    const startedAt = Date.now();
+    await interruptibleSleep(60_000, controller.signal);
+
+    expect(Date.now() - startedAt).toBeLessThan(1_000);
+  });
+
+  it("resolves as soon as the signal aborts mid-sleep", async () => {
+    const controller = new AbortController();
+    const startedAt = Date.now();
+    const sleeping = interruptibleSleep(60_000, controller.signal);
+
+    setTimeout(() => controller.abort(), 10);
+    await sleeping;
+
+    expect(Date.now() - startedAt).toBeLessThan(1_000);
+  });
+
+  it("still resolves normally when the sleep elapses without an abort", async () => {
+    const controller = new AbortController();
+    await interruptibleSleep(5, controller.signal);
+
+    expect(controller.signal.aborted).toBe(false);
+  });
+});
+
+describe("createWorkerShutdownController", () => {
+  it("interrupts a long sleep when SIGTERM arrives", async () => {
+    const { emitter, processRef } = fakeProcess();
+    const shutdown = createWorkerShutdownController({ processRef });
+
+    expect(shutdown.stopping).toBe(false);
+
+    const startedAt = Date.now();
+    // The default worker tick interval is 15 minutes; before this controller the
+    // boolean-only SIGTERM handler left the worker sleeping for the remainder of it
+    // and ECS SIGKILLed it after StopTimeout (30s).
+    const sleeping = shutdown.sleep(15 * 60 * 1000);
+    setTimeout(() => emitter.emit("SIGTERM"), 10);
+    await sleeping;
+
+    expect(shutdown.stopping).toBe(true);
+    expect(Date.now() - startedAt).toBeLessThan(1_000);
+    shutdown.dispose();
+  });
+
+  it("interrupts a long sleep when SIGINT arrives", async () => {
+    const { emitter, processRef } = fakeProcess();
+    const shutdown = createWorkerShutdownController({ processRef });
+
+    const sleeping = shutdown.sleep(15 * 60 * 1000);

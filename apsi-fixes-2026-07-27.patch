+/** Canonical content type for a file name, or `undefined` when not allowlisted. */
+export function contentTypeForFileName(fileName: string): string | undefined {
+  return CONTENT_TYPE_BY_EXTENSION[fileExtension(fileName)];
+}
+
+function matchesPrefix(bytes: Uint8Array, prefix: readonly number[]): boolean {
+  if (bytes.length < prefix.length) return false;
+  return prefix.every((byte, index) => bytes[index] === byte);
+}
+
+/**
+ * Returns false only when the bytes carry a recognised signature that is
+ * inconsistent with `contentType`. Unrecognised bytes are inconclusive (most
+ * allowlisted formats have no reliable short signature) and pass.
+ */
+function bytesAreConsistentWith(bytes: Uint8Array, contentType: string): boolean {
+  const signature = MAGIC_BYTE_SIGNATURES.find((candidate) => matchesPrefix(bytes, candidate.prefix));
+  if (signature) {
+    return signature.contentTypes.includes(contentType);
+  }
+
+  // No signature matched: reject only if the claimed type is one we know how
+  // to recognise, i.e. the bytes should have matched and did not.
+  const expected = MAGIC_BYTE_SIGNATURES.find((candidate) => candidate.contentTypes.includes(contentType));

diff --git a/crawler/tests/test_compliance.py b/crawler/tests/test_compliance.py
new file mode 100644
index 0000000..b51812e
--- /dev/null
+++ b/crawler/tests/test_compliance.py
@@ -0,0 +1,727 @@
+"""Legal-compliance behaviour of the shared HTTP layer and the source gates.
+
+Covers D1 (honest identity), D2 (no browser impersonation), D3 (robots.txt),
+D4 (per-origin rate limiting and backoff), D5 (ingestion kill switch) and
+D6 (BidNet opt-in). No test here performs a real network request: every
+transport, robots fetcher, clock and sleeper is injected.
+"""
+
+import json
+import sqlite3
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from apsi_crawler.cli import main
+from apsi_crawler.html.public_page import fetch_html
+from apsi_crawler.net import identity, sanitize_headers
+from apsi_crawler.net import robots as robots_module
+from apsi_crawler.net import throttle as throttle_module
+from apsi_crawler.net.approval import is_source_approved, require_source_approved
+from apsi_crawler.net.client import PoliteSession
+from apsi_crawler.net.errors import (
+    RobotsDisallowedError,
+    RobotsUnavailableError,
+    SourceNotApprovedError,
+    SourceRequiresLegalReviewError,
+)
+from apsi_crawler.net.throttle import DomainThrottle, parse_retry_after
+from apsi_crawler.sources import registry
+from apsi_crawler.sources.bidnet_policy import BIDNET_SOURCE_IDS
+from apsi_crawler.spiders.co_bidnet import fetch_co_bidnet_opportunities
+from apsi_crawler.spiders.de_bids import fetch_de_bids_opportunities
+from apsi_crawler.spiders.ga_procurement_registry import (
+    fetch_ga_procurement_registry_opportunities,
+)
+from apsi_crawler.storage.archive import archive_bid_documents
+from tests.test_cli import create_crawler_database
+
+
+FIXTURES_DIR = Path(__file__).parent / "fixtures"
+
+
+class FakeResponse:
+    def __init__(self, status_code=200, text="<html>ok</html>", headers=None, payload=None):
+        self.status_code = status_code
+        self.text = text
+        self.headers = headers or {"Content-Type": "text/html; charset=utf-8"}
+        self._payload = payload
+
+    def json(self):
+        return self._payload
+
+
+class FakeSession:
+    """Records every call; returns queued responses (or one response forever)."""
+
+    def __init__(self, responses):
+        self.responses = responses if isinstance(responses, list) else [responses]
+        self.calls = []
+        self.closed = False
+
+    def _next(self, method, url, **kwargs):
+        self.calls.append({"method": method, "url": url, **kwargs})
+        response = self.responses[min(len(self.calls) - 1, len(self.responses) - 1)]
+        if isinstance(response, Exception):
+            raise response
+        return response
+
+    def get(self, url, **kwargs):
+        return self._next("get", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self._next("post", url, **kwargs)
+
+    def close(self):
+        self.closed = True
+
+
+class FakeClock:
+    """Monotonic clock that only advances when something sleeps."""
+
+    def __init__(self):
+        self.now = 0.0
+        self.sleeps = []
+
+    def monotonic(self):
+        return self.now
+
+    def sleep(self, seconds):
+        self.sleeps.append(seconds)
+        self.now += seconds
+
+
+def robots_cache(body, status_code=200):
+    return robots_module.RobotsCache(fetcher=lambda url, timeout: (status_code, body))
+
+
+def install_robots(monkeypatch, body, status_code=200):
+    cache = robots_cache(body, status_code)
+    monkeypatch.setattr(robots_module, "_DEFAULT_CACHE", cache)
+    return cache
+
+
+def install_throttle(monkeypatch, clock):
+    throttle = DomainThrottle(clock=clock.monotonic, sleeper=clock.sleep)
+    monkeypatch.setattr(throttle_module, "_DEFAULT_THROTTLE", throttle)
+    return throttle
+
+
+# ---------------------------------------------------------------------------
+# D1: honest, contactable identity
+# ---------------------------------------------------------------------------
+
+
+def test_user_agent_is_honest_and_carries_contact_details():
+    agent = identity.user_agent()
+
+    assert agent.startswith("APSiBot/")
+    assert "Mozilla" not in agent
+    assert "Chrome" not in agent
+    assert "/bot" in agent
+    assert "@" in agent
+
+
+def test_user_agent_domain_and_mailbox_come_from_the_environment(monkeypatch):
+    monkeypatch.setenv("APSI_BOT_DOMAIN", "apsi.example.com")
+    monkeypatch.setenv("APSI_BOT_CONTACT_EMAIL", "crawler-abuse@apsi.example.com")
+
+    assert identity.user_agent() == (
+        "APSiBot/1.0 (+https://apsi.example.com/bot; crawler-abuse@apsi.example.com)"
+    )
+    assert identity.default_headers()["From"] == "crawler-abuse@apsi.example.com"
+
+
+def test_no_spider_ships_a_browser_user_agent():
+    """No adapter may carry a consumer-browser UA string.
+
+    ``apsi_crawler/net`` is excluded because that is where the policy is
+    documented; comment lines are excluded for the same reason.
+    """
+    package = Path(__file__).resolve().parents[1] / "apsi_crawler"
+    offenders = []
+    for path in package.rglob("*.py"):
+        if path.parent.name == "net":
+            continue
+        for number, line in enumerate(path.read_text().splitlines(), start=1):
+            if line.lstrip().startswith("#"):
+                continue
+            if "Mozilla/" in line or "Chrome/" in line:
+                offenders.append(f"{path}:{number}")
+
+    assert offenders == []

+import { describe, expect, it } from "vitest";
+import {
+  MAX_UPLOAD_REQUEST_BYTES,
+  exceedsRequestBodyLimit,
+  payloadTooLargeResponse,
+  requestContentLength,
+} from "./request-body-limit";
+
+function requestWithContentLength(value?: string) {
+  return new Request("http://localhost/api/intents/intent_1/artifacts", {
+    method: "POST",
+    headers: value === undefined ? {} : { "content-length": value },
+  });
+}
+
+describe("requestContentLength", () => {
+  it("parses a numeric Content-Length", () => {
+    expect(requestContentLength(requestWithContentLength("1024"))).toBe(1024);
+    expect(requestContentLength(requestWithContentLength(" 0 "))).toBe(0);
+  });
+
+  it("returns null for absent or unparseable values", () => {
+    expect(requestContentLength(requestWithContentLength())).toBeNull();
+    expect(requestContentLength(requestWithContentLength("not-a-number"))).toBeNull();
+    expect(requestContentLength(requestWithContentLength("-5"))).toBeNull();
+  });
+});
+
+describe("exceedsRequestBodyLimit", () => {
+  it("rejects a declared body above the ceiling", () => {
+    expect(exceedsRequestBodyLimit(requestWithContentLength(String(MAX_UPLOAD_REQUEST_BYTES + 1)))).toBe(true);
+  });
+
+  it("accepts a declared body at or below the ceiling", () => {
+    expect(exceedsRequestBodyLimit(requestWithContentLength(String(MAX_UPLOAD_REQUEST_BYTES)))).toBe(false);
+    expect(exceedsRequestBodyLimit(requestWithContentLength("1024"))).toBe(false);
+  });
+
+  it("treats a missing Content-Length as inconclusive so chunked uploads still reach the size check", () => {
+    expect(exceedsRequestBodyLimit(requestWithContentLength())).toBe(false);
+  });
+
+  it("honours a caller-supplied ceiling", () => {
+    expect(exceedsRequestBodyLimit(requestWithContentLength("2048"), 1024)).toBe(true);
+  });
+});
+
+describe("payloadTooLargeResponse", () => {
+  it("returns a 413 with a stable error code", async () => {
+    const response = payloadTooLargeResponse();
+    const body = await response.json();
+
+    expect(response.status).toBe(413);
+    expect(body.error.code).toBe("PAYLOAD_TOO_LARGE");
+    expect(body.error.message).toContain("30MB");
+  });
+});

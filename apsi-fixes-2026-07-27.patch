diff --git a/crawler/apsi_crawler/sources/bidnet_policy.py b/crawler/apsi_crawler/sources/bidnet_policy.py
new file mode 100644
index 0000000..05618b6
--- /dev/null
+++ b/crawler/apsi_crawler/sources/bidnet_policy.py
@@ -0,0 +1,108 @@
+"""BidNet Direct opt-in policy (D6).
+
+19 state adapters -- 38% of all state sources -- do not read a state portal at
+all. They scrape ``bidnetdirect.com``, a **commercial, paid aggregator**. Two
+facts in this repository say we should not be doing that by default:
+
+* ``ops-evidence/source-health/source-health-access-review.json`` classifies the
+  CO and OH BidNet routes as ``"classification": "login_required"`` with
+  ``"reviewMode": "vendor_account"`` -- i.e. this project's own access review
+  found the content sits behind a vendor account.
+* ``docs/operations/known-limitations.md`` states that sources in that category
+  must stay blocked.
+
+Republishing a paid aggregator's compiled listings, at ~1,800 requests/day
+against a single host, is the single largest cease-and-desist risk in the
+crawler. So these sources are **off unless an operator explicitly turns them
+on**. The code is kept intact -- this is a policy gate, not a deletion -- so
+that the moment the legal position is cleared, the switch flips and nothing has
+to be rewritten.
+
+Before setting ``APSI_ENABLE_BIDNET_SOURCES=1``, the following must be done and
+recorded:
+
+1. Read bidnetdirect.com's Terms of Use and confirm automated collection and
+   downstream republication of solicitation listings are permitted, or obtain
+   written permission / a data licence from BidNet.
+2. Resolve the ``login_required`` / ``vendor_account`` finding in
+   ``source-health-access-review.json``: either the data is genuinely public, or
+   we hold an account whose terms allow this use.
+3. Confirm https://www.bidnetdirect.com/robots.txt permits the paths we fetch
+   (the crawler enforces this independently, but it should be checked as part of
+   the review, not discovered at runtime).
+4. Prefer the official state portal wherever one is machine-readable; BidNet
+   should be a documented fallback, not the primary route for 19 states.
+5. Update ``docs/operations/known-limitations.md`` so the deployed policy and the
+   written policy agree.
+"""
+
+import os
+
+
+BIDNET_OPT_IN_ENV = "APSI_ENABLE_BIDNET_SOURCES"
+
+#: Every source whose live fetcher hits bidnetdirect.com.
+#: 17 from ``spiders/state_bidnet.py`` plus ``co_bidnet`` and ``wv_bidnet``.
+BIDNET_SOURCE_IDS = frozenset(
+    {
+        "al_state_procurement",
+        "ak_state_procurement",
+        "az_state_procurement",
+        "co_state_procurement",
+        "id_state_procurement",
+        "ky_state_procurement",
+        "la_state_procurement",
+        "md_state_procurement",
+        "mi_state_procurement",
+        "mn_state_procurement",

+export interface SqliteColumnDefinition {
+  name: string;
+  definition: string;
+}
+
+const ensuredSqliteColumns = new WeakMap<object, Set<string>>();
+
+function isSafeIdentifier(value: string) {
+  return /^[A-Za-z_][A-Za-z0-9_]*$/.test(value);
+}
+
+/**
+ * Adds missing columns to an existing SQLite table, once per process and per
+ * database handle.
+ *
+ * Used for columns that a feature owns end to end (the outbox claim/lease
+ * columns) so the feature keeps working against databases created by an older
+ * `runMigrations`, instead of failing at runtime until the next migration ships.
+ * No-op when the table does not exist yet.
+ */
+export function ensureSqliteColumns(
+  db: AppDatabase,
+  tableName: string,
+  columns: readonly SqliteColumnDefinition[],
+) {
+  if (!isSafeIdentifier(tableName)) {
+    throw new Error(`Invalid SQLite table name: ${tableName}`);
+  }
+
+  const client = db.$client;
+  const cacheKey = `${tableName}:${columns.map((column) => column.name).join(",")}`;
+  const ensured = ensuredSqliteColumns.get(client) ?? new Set<string>();
+  if (ensured.has(cacheKey)) return;
+
+  const existing = new Set(
+    (client.prepare(`PRAGMA table_info(${tableName})`).all() as Array<{ name?: unknown }>).map((row) =>
+      String(row.name),
+    ),
+  );
+
+  if (existing.size > 0) {
+    for (const column of columns) {
+      if (!isSafeIdentifier(column.name)) {
+        throw new Error(`Invalid SQLite column name: ${column.name}`);
+      }
+      if (existing.has(column.name)) continue;
+
+      client.exec(`ALTER TABLE ${tableName} ADD COLUMN ${column.name} ${column.definition}`);
+    }
+
+    ensured.add(cacheKey);
+    ensuredSqliteColumns.set(client, ensured);
+  }
+}

+  { prefix: [0x89, 0x50, 0x4e, 0x47], contentTypes: ["image/png"] },
+  { prefix: [0xff, 0xd8, 0xff], contentTypes: ["image/jpeg"] },
+  { prefix: [0x47, 0x49, 0x46, 0x38], contentTypes: ["image/gif"] },
+  {
+    prefix: [0x50, 0x4b, 0x03, 0x04], // PK\x03\x04 — ZIP container
+    contentTypes: [
+      "application/zip",
+      CONTENT_TYPE_BY_EXTENSION.docx,
+      CONTENT_TYPE_BY_EXTENSION.xlsx,
+      CONTENT_TYPE_BY_EXTENSION.pptx,

+
+function fakeProcess() {
+  const emitter = new EventEmitter();
+  const processRef: WorkerShutdownProcess = {
+    once: (event, listener) => emitter.once(event, listener),
+    off: (event, listener) => emitter.off(event, listener),
+  };
+

diff --git a/frontend/src/server/security/crawler-run-token.ts b/frontend/src/server/security/crawler-run-token.ts
new file mode 100644
index 0000000..e4287c7
--- /dev/null
+++ b/frontend/src/server/security/crawler-run-token.ts
@@ -0,0 +1,43 @@
+import { timingSafeEqual } from "node:crypto";
+
+/**
+ * Shared bearer-token check for the operator-triggered crawler run endpoints
+ * (`/api/crawler/state/run`, `/api/crawler/sam-gov/run`).
+ *
+ * These endpoints kick off a full crawl across 50+ state portals, so they are
+ * both expensive and externally visible. The previous implementation opened
+ * with `if (!requiredToken) return true` — i.e. when `CRAWLER_RUN_TOKEN` was
+ * not configured, ANY anonymous internet caller could POST and start the
+ * whole batch, with no `NODE_ENV` gate to limit the blast radius to local
+ * development. That fail-open is removed: a missing or non-matching token
+ * simply fails this check, and the route falls back to requiring a real
+ * admin/operator session before running anything.
+ */
+export function matchesCrawlerRunToken(
+  request: Request,
+  env: Record<string, string | undefined> = process.env,
+): boolean {
+  const requiredToken = env.CRAWLER_RUN_TOKEN?.trim();
+  if (!requiredToken) return false;
+
+  const presented = crawlerRunTokenFromRequest(request);
+  if (!presented) return false;
+
+  return constantTimeEquals(presented, requiredToken);
+}
+
+export function crawlerRunTokenFromRequest(request: Request): string | null {
+  const authorization = request.headers.get("authorization");
+  if (authorization?.startsWith("Bearer ")) {
+    return authorization.slice("Bearer ".length).trim() || null;
+  }
+
+  return request.headers.get("x-crawler-token")?.trim() || null;
+}
+
+function constantTimeEquals(actual: string, expected: string): boolean {
+  const actualBuffer = Buffer.from(actual, "utf8");
+  const expectedBuffer = Buffer.from(expected, "utf8");
+
+  return actualBuffer.length === expectedBuffer.length && timingSafeEqual(actualBuffer, expectedBuffer);
+}

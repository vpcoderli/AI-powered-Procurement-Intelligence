+import { describe, expect, it } from "vitest";
+import { STATE_CRAWLER_SOURCES } from "../src/lib/state-crawler-sources";
+import { createTestDatabase } from "../src/server/db/test-utils";
+import { bids } from "../src/server/db/schema";
+import { createRiskChecklistReport } from "../src/server/risk/checklist";
+import { seedStateCoverageBids } from "./seed-db";
+
+const NOW = new Date("2026-07-27T00:00:00.000Z");
+
+describe("seedStateCoverageBids", () => {
+  it("gives every state an active bid so the 50-state risk gates can pass", async () => {
+    const testDb = await createTestDatabase({ seed: true });
+
+    try {
+      // Baseline: the mock dataset alone covers only a handful of states, which
+      // is why `risk:check` failed on a clean checkout.
+      const before = await createRiskChecklistReport(testDb.db, NOW);
+      expect(before.checks.find((check) => check.id === "state-coverage")?.ok).toBe(false);
+
+      const created = seedStateCoverageBids(testDb.db, NOW);
+      expect(created.length).toBeGreaterThan(0);
+
+      const after = await createRiskChecklistReport(testDb.db, NOW);
+      const coverage = after.checks.find((check) => check.id === "state-coverage");
+      const dataQuality = after.checks.find((check) => check.id === "state-data-quality-gate");
+
+      expect(coverage?.ok).toBe(true);
+      expect(coverage?.summary).toContain("50/50");
+      expect(dataQuality?.ok).toBe(true);
+      expect(after.ok).toBe(true);
+    } finally {
+      await testDb.cleanup();
+    }
+  });
+
+  it("does not overwrite states that the mock dataset already covers", async () => {
+    const testDb = await createTestDatabase({ seed: true });
+
+    try {
+      const preexisting = testDb.db
+        .select({ id: bids.id, stateCode: bids.stateCode })
+        .from(bids)
+        .all()
+        .filter((row) => row.stateCode && !row.id.startsWith("seed_state_coverage_"));
+      const coveredStates = new Set(preexisting.map((row) => row.stateCode));
+
+      const created = seedStateCoverageBids(testDb.db, NOW);
+
+      for (const stateCode of created) {
+        expect(coveredStates.has(stateCode)).toBe(false);
+      }
+      expect(created.length).toBe(
+        STATE_CRAWLER_SOURCES.filter((source) => !coveredStates.has(source.stateCode)).length,
+      );
+    } finally {
+      await testDb.cleanup();
+    }
+  });
+
+  it("is idempotent across repeated seed runs", async () => {
+    const testDb = await createTestDatabase({ seed: true });
+
+    try {
+      const first = seedStateCoverageBids(testDb.db, NOW);
+      const countAfterFirst = testDb.db.select({ id: bids.id }).from(bids).all().length;
+
+      const second = seedStateCoverageBids(testDb.db, NOW);
+      const countAfterSecond = testDb.db.select({ id: bids.id }).from(bids).all().length;
+
+      expect(first.length).toBeGreaterThan(0);
+      expect(second).toEqual([]);
+      expect(countAfterSecond).toBe(countAfterFirst);
+    } finally {
+      await testDb.cleanup();
+    }
+  });
+
+  it("uses the canonical state portal URL rather than a placeholder", async () => {
+    const testDb = await createTestDatabase({ seed: true });
+
+    try {
+      seedStateCoverageBids(testDb.db, NOW);
+
+      const seeded = testDb.db
+        .select()
+        .from(bids)
+        .all()
+        .filter((row) => row.id.startsWith("seed_state_coverage_"));
+      const baseUrls = new Map(STATE_CRAWLER_SOURCES.map((source) => [source.stateCode, source.baseUrl]));
+
+      expect(seeded.length).toBeGreaterThan(0);
+      for (const row of seeded) {
+        expect(row.sourceUrl).toBe(baseUrls.get(row.stateCode));
+        expect(row.isActive).toBe(1);
+        expect(row.issuerType).toBe("state");
+        expect(row.description.trim()).not.toBe("");
+      }
+    } finally {
+      await testDb.cleanup();
+    }
+  });
+});

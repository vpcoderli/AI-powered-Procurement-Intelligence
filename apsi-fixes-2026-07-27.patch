+function fakeMigrationPool(failureCode: string): Pool {
+  const query = async (sql: string) => {
+    if (sql.trim().startsWith("CREATE UNIQUE INDEX")) {
+      throw Object.assign(new Error(`fake ${failureCode}`), { code: failureCode });
+    }
+
+    return [[], undefined];
+  };
+
+  return { query } as unknown as Pool;
+}

+import { readdirSync, readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+
+/**
+ * Enumerates every API route that exports a state-changing handler and asserts
+ * it either calls `verifyCsrfSafe` or is on an explicit, justified exemption
+ * list. Before this, 30 of 47 mutating routes had no CSRF check at all and
+ * relied solely on `SameSite=Lax` — see the module doc comment in ./csrf.ts
+ * for why that is not sufficient on its own.
+ *
+ * A new mutating route added without a CSRF guard fails this test, which is
+ * the point: there is no `middleware.ts` in this codebase to apply the check
+ * centrally, so coverage has to be enforced by a test.
+ */
+
+const apiRoot = new URL("../../app/api/", import.meta.url);
+
+/**
+ * Routes that legitimately have no CSRF check. CSRF requires an *ambient*
+ * credential the browser attaches automatically; a signed webhook body, a
+ * bearer token, or a one-time token in the request body is not one.
+ */
+const EXEMPT_ROUTES: ReadonlyMap<string, string> = new Map([
+  [
+    "src/app/api/billing/webhook/route.ts",
+    "Stripe webhook: authenticated by the Stripe-Signature header, never by a browser cookie.",
+  ],
+  [
+    "src/app/api/notifications/webhooks/ses/route.ts",
+    "AWS SNS callback: authenticated by SNS message signature verification.",
+  ],
+  [
+    "src/app/api/notifications/webhooks/sendgrid/route.ts",
+    "SendGrid event webhook: authenticated by its own signature verification.",
+  ],
+  [
+    "src/app/api/account/workspace/invitations/accept/route.ts",
+    "Invite-token gated: the caller has no session yet, so there is no ambient credential to abuse.",
+  ],
+  [
+    "src/app/api/auth/password-reset/request/route.ts",
+    "No ambient credential; rate-limited by loginGuard. Adding an Origin check would break password-reset links opened from email clients.",
+  ],
+  [
+    "src/app/api/auth/password-reset/confirm/route.ts",
+    "Authenticated by the single-use reset token in the request body, not by a cookie.",
+  ],
+  [
+    "src/app/api/marketing/request-demo/route.ts",
+    "Anonymous public lead form: an attacker can POST it directly, so CSRF buys nothing.",
+  ],
+  [
+    "src/app/api/marketing/signup-start/route.ts",
+    "Anonymous public lead form: an attacker can POST it directly, so CSRF buys nothing.",
+  ],
+]);
+
+/**
+ * Routes that apply the check conditionally rather than as the first statement
+ * of the handler, because they support a non-cookie auth path that must not be
+ * subjected to an Origin check.
+ */
+const CONDITIONAL_ROUTES: ReadonlySet<string> = new Set([
+  "src/app/api/crawler/state/run/route.ts",
+  "src/app/api/crawler/sam-gov/run/route.ts",
+]);
+
+const MUTATING_HANDLER = /export\s+(?:async\s+function|const)\s+(POST|PUT|PATCH|DELETE)\b/;
+
+function routeFiles(url: URL): URL[] {
+  return readdirSync(url, { withFileTypes: true }).flatMap((entry) => {
+    const child = new URL(`${entry.name}${entry.isDirectory() ? "/" : ""}`, url);
+
+    if (entry.isDirectory()) return routeFiles(child);
+    return entry.name === "route.ts" ? [child] : [];
+  });
+}
+
+function relativeRoutePath(url: URL) {
+  return decodeURIComponent(url.href.replace(apiRoot.href, "src/app/api/"));
+}
+
+function mutatingRoutes() {
+  return routeFiles(apiRoot)
+    .map((url) => ({ path: relativeRoutePath(url), source: readFileSync(url, "utf8") }))
+    .filter((route) => MUTATING_HANDLER.test(route.source));
+}
+
+describe("CSRF route coverage", () => {
+  it("finds mutating API routes to check", () => {
+    expect(mutatingRoutes().length).toBeGreaterThan(40);
+  });
+
+  it("guards every state-changing API route with verifyCsrfSafe or an explicit exemption", () => {
+    const unguarded = mutatingRoutes()
+      .filter((route) => !route.source.includes("verifyCsrfSafe") && !EXEMPT_ROUTES.has(route.path))
+      .map((route) => route.path);
+
+    expect(unguarded).toEqual([]);
+  });
+
+  it("keeps the exemption list free of routes that have since gained a CSRF check", () => {
+    const paths = new Set(mutatingRoutes().map((route) => route.path));
+    const stale = [...EXEMPT_ROUTES.keys()].filter((path) => !paths.has(path));
+
+    expect(stale).toEqual([]);
+  });
+
+  it("rejects with the shared 403 helper rather than an ad-hoc response", () => {
+    const missingHelper = mutatingRoutes()
+      .filter(
+        (route) =>
+          route.source.includes("verifyCsrfSafe") &&
+          !route.source.includes("csrfRejectedResponse") &&
+          !CONDITIONAL_ROUTES.has(route.path),
+      )
+      .map((route) => route.path);
+
+    expect(missingHelper).toEqual([]);
+  });
+});

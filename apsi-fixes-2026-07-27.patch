+++ b/frontend/src/server/storage/content-type.ts
@@ -0,0 +1,156 @@
+/**
+ * Content-type derivation for stored files.
+ *
+ * Everything that lands in object storage arrives as a `File` from a
+ * `multipart/form-data` upload, whose `.type` is a value the *client* chose.
+ * Persisting that string verbatim (as `@/server/artifacts/service` used to)
+ * and replaying it as the `Content-Type` of a later download lets an uploader
+ * pick the type the browser will interpret the bytes as — the classic stored
+ * XSS / HTML-smuggling primitive (`evil.pdf` declared as `text/html`, served
+ * same-origin from the app's own domain).
+ *
+ * So the declared value is never trusted. The type is derived from the file
+ * extension against a small allowlist of formats this product actually deals
+ * in (procurement paperwork: PDF, Office documents, images, plain text,
+ * archives). Anything not on the allowlist degrades to
+ * `application/octet-stream`, which browsers download rather than render.
+ * When the leading bytes are available they are sniffed as well, and a
+ * mismatch between the magic bytes and the extension also degrades to
+ * `application/octet-stream` rather than believing either side.
+ *
+ * This is defence in depth alongside the `X-Content-Type-Options: nosniff`
+ * and CSP headers configured in `frontend/next.config.ts`, and the
+ * `Content-Disposition: attachment` these download routes already send.
+ */
+
+export const DEFAULT_BINARY_CONTENT_TYPE = "application/octet-stream";
+
+/**
+ * Extension -> canonical content type. Deliberately excludes anything the
+ * browser executes or renders as markup (`.html`, `.htm`, `.svg`, `.xhtml`,
+ * `.js`, `.xml`): those degrade to `application/octet-stream`.
+ */
+const CONTENT_TYPE_BY_EXTENSION: Readonly<Record<string, string>> = {
+  pdf: "application/pdf",
+  txt: "text/plain; charset=utf-8",
+  csv: "text/csv; charset=utf-8",
+  json: "application/json",
+  doc: "application/msword",
+  docx: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+  xls: "application/vnd.ms-excel",
+  xlsx: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+  ppt: "application/vnd.ms-powerpoint",
+  pptx: "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+  rtf: "application/rtf",
+  png: "image/png",
+  jpg: "image/jpeg",
+  jpeg: "image/jpeg",
+  gif: "image/gif",
+  webp: "image/webp",
+  tif: "image/tiff",
+  tiff: "image/tiff",
+  zip: "application/zip",
+};
+
+interface MagicByteSignature {
+  /** Byte prefix that identifies the format. */
+  prefix: readonly number[];
+  /** Content types the prefix is consistent with. */
+  contentTypes: readonly string[];
+}
+
+/**

+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { runMigrations } from "@/server/db/migrate";
+import { mysqlMigrationStatements } from "@/server/db/mysql";
+import { createTestDatabase, type TestDatabase } from "@/server/db/test-utils";
+
+interface SqliteIndexRow {
+  name: string;
+  unique: number;
+}
+
+function subscriptionEventIndexes(testDb: TestDatabase) {
+  return testDb.db.$client
+    .prepare("PRAGMA index_list(subscription_events)")
+    .all() as SqliteIndexRow[];
+}
+
+describe("subscription_events provider_event_id uniqueness", () => {
+  let testDb: TestDatabase;
+
+  beforeEach(async () => {
+    testDb = await createTestDatabase({ seed: false });
+  });
+
+  afterEach(async () => {
+    await testDb.cleanup();
+  });
+
+  it("creates the unique webhook idempotency index on SQLite", () => {
+    expect(subscriptionEventIndexes(testDb)).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({ name: "idx_subscription_events_provider_event_id", unique: 1 }),
+      ]),
+    );
+  });
+
+  it("backfills provider_event_id on databases created before the column existed", () => {
+    testDb.db.$client.exec("DROP INDEX idx_subscription_events_provider_event_id");
+    testDb.db.$client.exec("ALTER TABLE subscription_events DROP COLUMN provider_event_id");
+
+    expect(() => runMigrations(testDb.db)).not.toThrow();
+    expect(subscriptionEventIndexes(testDb)).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({ name: "idx_subscription_events_provider_event_id", unique: 1 }),
+      ]),
+    );
+  });
+
+  it("exports the unique index and an indexable column type to the MySQL migration", () => {
+    const statements = mysqlMigrationStatements();
+    const createTable = statements.find((statement) =>
+      statement.startsWith("CREATE TABLE IF NOT EXISTS subscription_events"),
+    );
+
+    expect(createTable).toBeDefined();
+    expect(createTable).toMatch(/provider_event_id VARCHAR\(191\)/);
+    expect(statements).toContain(
+      "CREATE UNIQUE INDEX idx_subscription_events_provider_event_id ON subscription_events(provider_event_id)",
+    );
+  });
+});

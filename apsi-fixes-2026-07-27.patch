+import { describe, expect, it } from "vitest";
+import {
+  DEFAULT_BINARY_CONTENT_TYPE,
+  contentTypeForFileName,
+  fileExtension,
+  resolveSafeContentType,
+  safeDownloadContentType,
+} from "./content-type";
+
+describe("fileExtension", () => {
+  it("lowercases and trims", () => {
+    expect(fileExtension("  Report.PDF  ")).toBe("pdf");
+    expect(fileExtension("archive.tar.gz")).toBe("gz");
+    expect(fileExtension("no-extension")).toBe("");
+    expect(fileExtension(".hiddenfile")).toBe("hiddenfile");
+  });
+});
+
+describe("contentTypeForFileName", () => {
+  it("maps allowlisted procurement formats", () => {
+    expect(contentTypeForFileName("sow.pdf")).toBe("application/pdf");
+    expect(contentTypeForFileName("pricing.xlsx")).toBe(
+      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+    );
+  });
+
+  it("does not map browser-executable formats", () => {
+    for (const name of ["evil.html", "evil.htm", "evil.svg", "evil.js", "evil.xml", "evil.xhtml"]) {
+      expect(contentTypeForFileName(name)).toBeUndefined();
+    }
+  });
+});
+
+describe("resolveSafeContentType", () => {
+  it("ignores the client-declared content type entirely", () => {
+    expect(
+      resolveSafeContentType({ fileName: "sow.pdf", declaredContentType: "text/html" }),
+    ).toBe("application/pdf");
+  });
+
+  it("degrades unknown extensions to application/octet-stream", () => {
+    expect(
+      resolveSafeContentType({ fileName: "payload.html", declaredContentType: "text/html" }),
+    ).toBe(DEFAULT_BINARY_CONTENT_TYPE);
+    expect(resolveSafeContentType({ fileName: "payload.svg" })).toBe(DEFAULT_BINARY_CONTENT_TYPE);
+    expect(resolveSafeContentType({ fileName: "payload" })).toBe(DEFAULT_BINARY_CONTENT_TYPE);
+  });
+
+  it("accepts bytes whose magic signature matches the extension", () => {
+    const pdfBytes = new Uint8Array([0x25, 0x50, 0x44, 0x46, 0x2d, 0x31, 0x2e, 0x37]);
+    expect(resolveSafeContentType({ fileName: "sow.pdf", bytes: pdfBytes })).toBe("application/pdf");
+
+    const zipBytes = new Uint8Array([0x50, 0x4b, 0x03, 0x04, 0x00, 0x00]);
+    expect(resolveSafeContentType({ fileName: "pricing.xlsx", bytes: zipBytes })).toBe(
+      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+    );
+  });
+
+  it("degrades when the magic bytes contradict the extension", () => {
+    // HTML content wearing a .pdf name: the extension says PDF but the bytes
+    // do not start with %PDF, so neither claim is trusted.
+    const htmlBytes = new Uint8Array(Buffer.from("<script>alert(1)</script>"));
+    expect(resolveSafeContentType({ fileName: "notice.pdf", bytes: htmlBytes })).toBe(
+      DEFAULT_BINARY_CONTENT_TYPE,
+    );
+
+    const pngBytes = new Uint8Array([0x89, 0x50, 0x4e, 0x47]);
+    expect(resolveSafeContentType({ fileName: "logo.jpg", bytes: pngBytes })).toBe(
+      DEFAULT_BINARY_CONTENT_TYPE,
+    );
+  });
+
+  it("treats formats without a reliable signature as inconclusive rather than rejecting them", () => {
+    const textBytes = new Uint8Array(Buffer.from("plain notes"));
+    expect(resolveSafeContentType({ fileName: "notes.txt", bytes: textBytes })).toBe(
+      "text/plain; charset=utf-8",
+    );
+  });
+});
+
+describe("safeDownloadContentType", () => {
+  it("re-derives from the file name and ignores legacy stored values", () => {
+    expect(safeDownloadContentType("Notice.pdf", "text/html")).toBe("application/pdf");
+    expect(safeDownloadContentType("Notice.unknownext", "text/html")).toBe(DEFAULT_BINARY_CONTENT_TYPE);
+  });
+
+  it("honours a stored value only when it is itself allowlisted and the name has no usable extension", () => {
+    expect(safeDownloadContentType("download-note", "text/plain; charset=utf-8")).toBe(
+      "text/plain; charset=utf-8",
+    );
+    expect(safeDownloadContentType("download-note", "image/svg+xml")).toBe(DEFAULT_BINARY_CONTENT_TYPE);
+    expect(safeDownloadContentType("download-note", null)).toBe(DEFAULT_BINARY_CONTENT_TYPE);
+  });
+});

+ * Derives a content type that is safe to serve back, ignoring the
+ * client-declared value except as a tie-breaker. Never throws.
+ */
+export function resolveSafeContentType(input: ResolveSafeContentTypeInput): string {
+  const derived = contentTypeForFileName(input.fileName);
+  if (!derived) return DEFAULT_BINARY_CONTENT_TYPE;
+
+  if (input.bytes && input.bytes.length > 0 && !bytesAreConsistentWith(input.bytes, derived)) {
+    return DEFAULT_BINARY_CONTENT_TYPE;
+  }
+
+  return derived;
+}
+

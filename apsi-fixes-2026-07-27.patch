diff --git a/crawler/tests/conftest.py b/crawler/tests/conftest.py
new file mode 100644
index 0000000..e8a78d0
--- /dev/null
+++ b/crawler/tests/conftest.py
@@ -0,0 +1,57 @@
+"""Test-wide defaults for the compliance HTTP layer.
+
+Unit tests exercise parsers, not the network. This fixture puts the shared
+polite-HTTP layer into a deterministic offline mode so that:
+
+* no test can accidentally fetch a real ``robots.txt`` (the injected fetcher
+  returns an empty robots.txt, i.e. "no restrictions published"), and
+* no test pays the real 2-5s per-origin delay.
+
+Tests that *assert* on compliance behaviour (robots enforcement, throttling,
+backoff, the kill switch, the BidNet opt-in) build their own
+``RobotsCache`` / ``DomainThrottle`` with explicit rules and a fake clock, so
+they are unaffected by this fixture.
+"""
+
+import pytest
+
+from apsi_crawler.net import robots as robots_module
+from apsi_crawler.net import throttle as throttle_module
+
+
+def offline_robots_fetcher(url, timeout):
+    """Stand-in for a network fetch: an empty robots.txt allows everything."""
+    return 200, ""
+
+
+def _all_source_ids():
+    from apsi_crawler.sources.registry import SOURCES
+
+    return set(SOURCES) | {"sam_gov"}
+
+
+@pytest.fixture(autouse=True)
+def offline_polite_http(monkeypatch):
+    monkeypatch.setenv("APSI_CRAWL_MIN_DELAY_SECONDS", "0")
+    monkeypatch.setenv("APSI_CRAWL_MAX_DELAY_SECONDS", "0")
+
+    # D5: the kill switch denies by default, so tests that exercise unrelated
+    # behaviour (fixture replay, persistence, fallback) have to stand in for an
+    # operator who has approved every source. This is an explicit allowlist, not
+    # a bypass -- APSI_APPROVE_ALL_SOURCES is deliberately left unset so the
+    # allowlist code path is the one under test. Tests that assert the kill
+    # switch itself delete this variable first.
+    monkeypatch.setenv(
+        "APSI_APPROVED_SOURCE_IDS",
+        ",".join(sorted(_all_source_ids())),
+    )
+    monkeypatch.delenv("APSI_APPROVE_ALL_SOURCES", raising=False)
+    monkeypatch.delenv("APSI_ENABLE_BIDNET_SOURCES", raising=False)
+
+    cache = robots_module.RobotsCache(fetcher=offline_robots_fetcher)
+    monkeypatch.setattr(robots_module, "_DEFAULT_CACHE", cache)
+
+    throttle = throttle_module.DomainThrottle()
+    monkeypatch.setattr(throttle_module, "_DEFAULT_THROTTLE", throttle)
+
+    yield

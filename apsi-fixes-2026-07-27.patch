diff --git a/frontend/src/server/notifications/providers/suppression.test.ts b/frontend/src/server/notifications/providers/suppression.test.ts
new file mode 100644
index 0000000..1695686
--- /dev/null
+++ b/frontend/src/server/notifications/providers/suppression.test.ts
@@ -0,0 +1,134 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  classifySuppressionFromDeliveryEvent,
+  classifySuppressionFromSendFailure,
+  ingestOutboxDeliveryEventSuppressionsFromMysql,
+  listSuppressedRecipientsFromMysql,
+  nextAttemptDelayMs,
+  parseDeliveryEventMarker,
+  suppressRecipientFromMysql,
+} from "./suppression";
+
+describe("classifySuppressionFromDeliveryEvent", () => {
+  it("always suppresses complaints", () => {
+    expect(classifySuppressionFromDeliveryEvent("complaint", "abuse")).toBe("complaint");
+    expect(classifySuppressionFromDeliveryEvent("complaint", "")).toBe("complaint");
+  });
+
+  it("never suppresses on a delivery confirmation", () => {
+    expect(classifySuppressionFromDeliveryEvent("delivered", "delivered")).toBeNull();
+  });
+
+  it("suppresses SES permanent bounces but not transient ones", () => {
+    expect(classifySuppressionFromDeliveryEvent("bounce", "Permanent/General: smtp; 550 5.1.1")).toBe("hard_bounce");
+    expect(classifySuppressionFromDeliveryEvent("bounce", "Permanent/NoEmail")).toBe("hard_bounce");
+    expect(classifySuppressionFromDeliveryEvent("bounce", "Transient/MailboxFull")).toBeNull();
+    expect(classifySuppressionFromDeliveryEvent("bounce", "Transient/General: smtp; 452 4.2.2")).toBeNull();
+  });
+
+  it("treats SendGrid 4xx reasons and full mailboxes as soft", () => {
+    expect(classifySuppressionFromDeliveryEvent("bounce", "421 4.7.0 try again later")).toBeNull();
+    expect(classifySuppressionFromDeliveryEvent("bounce", "552 mailbox full")).toBeNull();
+    expect(classifySuppressionFromDeliveryEvent("bounce", "550 user over quota")).toBeNull();
+  });
+
+  it("fails safe: an unrecognized bounce detail suppresses", () => {
+    // Under-suppressing risks an SES account suspension; over-suppressing costs
+    // one address its alerts, which an operator can undo.
+    expect(classifySuppressionFromDeliveryEvent("bounce", "")).toBe("hard_bounce");
+    expect(classifySuppressionFromDeliveryEvent("bounce", "unclassified provider text")).toBe("hard_bounce");
+  });
+});
+
+describe("classifySuppressionFromSendFailure", () => {
+  it("suppresses only unambiguous permanent-mailbox errors", () => {
+    expect(classifySuppressionFromSendFailure("550 5.1.1 user unknown")).toBe("hard_bounce");
+    expect(classifySuppressionFromSendFailure("Recipient address rejected: no such user")).toBe("hard_bounce");
+  });
+
+  it("does not suppress throttling, auth or transient failures", () => {
+    expect(classifySuppressionFromSendFailure("Throttling: Maximum sending rate exceeded")).toBeNull();
+    expect(classifySuppressionFromSendFailure("The security token included in the request is invalid")).toBeNull();
+    expect(classifySuppressionFromSendFailure("451 4.3.0 temporary failure, retry")).toBeNull();
+    expect(classifySuppressionFromSendFailure("connect ECONNRESET")).toBeNull();
+    // 5.2.2 is "mailbox full" -- permanent-looking, but recoverable.
+    expect(classifySuppressionFromSendFailure("552 5.2.2 mailbox full")).toBeNull();
+  });
+});
+
+describe("parseDeliveryEventMarker", () => {
+  it("parses the marker outbox rows carry and ignores ordinary errors", () => {
+    expect(parseDeliveryEventMarker("provider_event:bounce: Permanent/General")).toEqual({
+      kind: "bounce",
+      detail: "Permanent/General",
+    });
+    expect(parseDeliveryEventMarker("Provider unavailable")).toBeNull();
+    expect(parseDeliveryEventMarker(null)).toBeNull();
+  });
+});
+
+describe("nextAttemptDelayMs", () => {
+  it("doubles per attempt and clamps at the maximum", () => {
+    expect(nextAttemptDelayMs(1, { baseDelayMs: 1_000, maxDelayMs: 10_000 })).toBe(1_000);
+    expect(nextAttemptDelayMs(2, { baseDelayMs: 1_000, maxDelayMs: 10_000 })).toBe(2_000);
+    expect(nextAttemptDelayMs(4, { baseDelayMs: 1_000, maxDelayMs: 10_000 })).toBe(8_000);
+    expect(nextAttemptDelayMs(9, { baseDelayMs: 1_000, maxDelayMs: 10_000 })).toBe(10_000);
+  });
+});
+
+describe("MySQL suppression store", () => {
+  function fakeMysql() {
+    const suppressions = new Map<string, unknown[]>();
+    const outboxRows: Array<{ id: string; recipient: string; lastError: string | null }> = [
+      { id: "n_1", recipient: "Bounced@Example.com", lastError: "provider_event:bounce: Permanent/General" },
+      { id: "n_2", recipient: "soft@example.com", lastError: "provider_event:bounce: Transient/General" },
+      { id: "n_3", recipient: "fine@example.com", lastError: "Provider unavailable" },
+    ];
+
+    return {
+      suppressions,
+      store: {
+        execute: vi.fn(async (sql: string, values: unknown[] = []) => {
+          if (sql.includes("INSERT INTO notification_suppressions")) {
+            const recipient = values[0] as string;
+            if (suppressions.has(recipient)) return [{ affectedRows: 0 }, undefined];
+            suppressions.set(recipient, values);
+            return [{ affectedRows: 1 }, undefined];
+          }
+
+          return [{ affectedRows: 1 }, undefined];
+        }),
+        query: vi.fn(async (sql: string) => {
+          if (sql.includes("FROM notification_outbox")) {
+            return [outboxRows.filter((row) => row.lastError?.startsWith("provider_event:")), undefined];
+          }
+          if (sql.includes("FROM notification_suppressions")) {
+            return [[...suppressions.keys()].map((recipient) => ({ recipient })), undefined];
+          }
+
+          return [[], undefined];
+        }),
+      },
+    };
+  }
+
+  it("ingests hard bounces from the outbox and normalizes the address", async () => {
+    const { store, suppressions } = fakeMysql();
+
+    const ingested = await ingestOutboxDeliveryEventSuppressionsFromMysql(store, "2026-05-28T01:00:00.000Z");
+
+    expect(ingested).toBe(1);
+    expect([...suppressions.keys()]).toEqual(["bounced@example.com"]);
+
+    const lookup = await listSuppressedRecipientsFromMysql(store, ["BOUNCED@example.com", "fine@example.com"]);
+    expect(lookup.has("bounced@example.com")).toBe(true);
+  });
+
+  it("treats a repeat suppression as a no-op", async () => {
+    const { store } = fakeMysql();
+    const input = { recipient: "ops@example.com", reason: "manual" as const, now: "2026-05-28T01:00:00.000Z" };
+
+    expect(await suppressRecipientFromMysql(store, input)).toBe(true);
+    expect(await suppressRecipientFromMysql(store, input)).toBe(false);
+  });
+});
diff --git a/frontend/src/server/notifications/providers/suppression.ts b/frontend/src/server/notifications/providers/suppression.ts
new file mode 100644
index 0000000..1be5d89
--- /dev/null
+++ b/frontend/src/server/notifications/providers/suppression.ts
@@ -0,0 +1,526 @@
+/**
+ * Recipient suppression list + per-row delivery backoff for the notification
+ * outbox.
+ *
+ * ## Why this exists
+ *
+ * `recordNotificationDeliveryEvent` (outbox-repository.ts) records an async SES/
+ * SendGrid bounce or complaint by setting the row's `status` to `failed` with a
+ * `provider_event:<kind>: <detail>` marker in `last_error`. But
+ * `listDeliverableNotifications` re-selects *any* row whose status is `pending` or
+ * `failed` as long as `attempt_count < maxAttempts`, with no time-based backoff.
+ * The result: a mailbox that just hard-bounced was immediately mailed again, up to
+ * the attempt limit, and nothing ever stopped *future* notifications to that same
+ * address. Sustained hard-bounce and complaint rates are exactly what gets an SES
+ * account put under review and then suspended.
+ *
+ * ## Where the tables come from
+ *
+ * `notification_suppressions` and `notification_delivery_backoff` are now
+ * declared in `@/server/db/schema` and created by `runMigrations`
+ * (`src/server/db/migrate.ts`), which is also what generates the MySQL DDL. The
+ * `CREATE TABLE IF NOT EXISTS` calls below are kept purely as a compatibility
+ * fallback for callers that reach this module against a connection that never
+ * ran migrations (ad-hoc scripts, older databases). They are no-ops once the
+ * migration has run, and the WeakSet cache means each connection pays for them
+ * at most once.
+ *
+ * - `notification_suppressions`  — one row per suppressed recipient.
+ * - `notification_delivery_backoff` — earliest next attempt per outbox row.
+ */
+import { like } from "drizzle-orm";
+import type { AppDatabase } from "@/server/db/client";
+import { mysqlExecute, mysqlSelectMany } from "@/server/db/mysql-runtime";
+import { notificationOutbox } from "@/server/db/schema";
+
+export type SuppressionReason = "hard_bounce" | "complaint" | "manual";
+
+export interface SuppressionRecord {
+  recipient: string;
+  reason: SuppressionReason;
+  detail: string;
+  source: string;
+  createdAt: string;
+}
+
+export interface SuppressRecipientInput {
+  recipient: string;
+  reason: SuppressionReason;
+  detail?: string;
+  /** Provenance: the outbox row id, webhook name, or operator that suppressed it. */
+  source?: string;
+  now: string;
+}
+
+export interface MysqlSuppressionStore {
+  query: (sql: string, values?: unknown[]) => Promise<[unknown[], unknown?]>;
+  execute: (sql: string, values?: never[]) => Promise<[unknown, unknown?]>;
+}
+
+export interface DeliveryBackoffOptions {
+  /** First retry delay; doubles per recorded attempt. Default 5 minutes. */
+  baseDelayMs?: number;
+  /** Upper bound on the computed delay. Default 6 hours. */
+  maxDelayMs?: number;
+}
+
+const DEFAULT_BACKOFF_BASE_DELAY_MS = 5 * 60 * 1000;
+const DEFAULT_BACKOFF_MAX_DELAY_MS = 6 * 60 * 60 * 1000;
+
+const SQLITE_SUPPRESSION_DDL = `
+  CREATE TABLE IF NOT EXISTS notification_suppressions (
+    recipient TEXT PRIMARY KEY,
+    reason TEXT NOT NULL,
+    detail TEXT NOT NULL DEFAULT '',
+    source TEXT NOT NULL DEFAULT '',
+    created_at TEXT NOT NULL
+  )
+`;
+
+const SQLITE_BACKOFF_DDL = `
+  CREATE TABLE IF NOT EXISTS notification_delivery_backoff (
+    notification_id TEXT PRIMARY KEY,
+    attempt_count INTEGER NOT NULL,
+    last_attempted_at TEXT NOT NULL,
+    next_attempt_at TEXT NOT NULL
+  )
+`;
+
+const MYSQL_SUPPRESSION_DDL = `
+  CREATE TABLE IF NOT EXISTS notification_suppressions (
+    recipient VARCHAR(320) NOT NULL PRIMARY KEY,
+    reason VARCHAR(32) NOT NULL,
+    detail TEXT NOT NULL,
+    source VARCHAR(255) NOT NULL,
+    created_at VARCHAR(64) NOT NULL
+  )
+`;
+
+const MYSQL_BACKOFF_DDL = `
+  CREATE TABLE IF NOT EXISTS notification_delivery_backoff (
+    notification_id VARCHAR(255) NOT NULL PRIMARY KEY,
+    attempt_count INT NOT NULL,
+    last_attempted_at VARCHAR(64) NOT NULL,
+    next_attempt_at VARCHAR(64) NOT NULL
+  )
+`;
+
+/**
+ * `CREATE TABLE IF NOT EXISTS` is cheap but not free, and the worker calls into
+ * this module on every tick, so remember which connections have already been
+ * prepared. Keyed on the connection object itself (not a module-level boolean) so
+ * tests that spin up one temp database per case still get their tables created.
+ */
+const preparedSqliteClients = new WeakSet<object>();
+const preparedMysqlStores = new WeakSet<object>();
+
+export function ensureSuppressionSchema(db: AppDatabase) {
+  const client = db.$client;
+  if (preparedSqliteClients.has(client)) return;
+
+  client.exec(SQLITE_SUPPRESSION_DDL);
+  client.exec(SQLITE_BACKOFF_DDL);
+  preparedSqliteClients.add(client);
+}
+
+export async function ensureSuppressionSchemaFromMysql(mysql: MysqlSuppressionStore) {
+  if (preparedMysqlStores.has(mysql)) return;
+
+  await mysqlExecute(mysql, MYSQL_SUPPRESSION_DDL);
+  await mysqlExecute(mysql, MYSQL_BACKOFF_DDL);
+  preparedMysqlStores.add(mysql);
+}
+
+/** Email addresses are case-insensitive in the parts that matter here. */
+export function normalizeRecipient(recipient: string) {
+  return recipient.trim().toLowerCase();
+}
+
+// ---------------------------------------------------------------------------
+// Bounce / complaint classification
+// ---------------------------------------------------------------------------
+
+/**
+ * Enhanced SMTP status codes that unambiguously mean "this mailbox will never
+ * accept mail": bad destination mailbox/system/address. Deliberately excludes
+ * 5.2.2 (mailbox full), 5.4.x (routing/DNS) and every 4.x.x code, which are
+ * transient and must not cost a user their alerts.
+ */
+const PERMANENT_SMTP_STATUS_CODES = [/\b5\.1\.1\b/, /\b5\.1\.2\b/, /\b5\.1\.3\b/, /\b5\.1\.10\b/];
+
+const PERMANENT_BOUNCE_PHRASES = [
+  /user unknown/i,
+  /no such user/i,
+  /does not exist/i,
+  /recipient address rejected/i,
+  /unrouteable address/i,
+  /invalid recipient/i,
+];
+
+/**
+ * Decides whether an already-recorded delivery event should suppress its
+ * recipient.
+ *
+ * Complaints always suppress: a spam report is an explicit "never mail me again"
+ * and is the single most damaging signal to sender reputation.
+ *
+ * Bounces suppress unless the detail marks them transient. SES formats bounce
+ * details as `<bounceType>/<bounceSubType>` (see `parseSesSnsNotification`), so
+ * `Transient/*` is recognizable; SendGrid supplies the receiving MTA's reason
+ * string instead, which is matched against the SMTP-code/phrase lists above. An
+ * *unrecognized* bounce is treated as permanent on purpose: the cost of holding
+ * back one legitimate email is far lower than the cost of an SES suspension.
+ */
+export function classifySuppressionFromDeliveryEvent(
+  kind: "bounce" | "complaint" | "delivered",
+  detail: string,
+): SuppressionReason | null {
+  if (kind === "complaint") return "complaint";
+  if (kind !== "bounce") return null;
+
+  if (/^transient\b/i.test(detail.trim())) return null;
+  if (/\b4\.\d+\.\d+\b/.test(detail)) return null;
+  if (/mailbox\s+full/i.test(detail) || /over\s+quota/i.test(detail)) return null;
+
+  return "hard_bounce";
+}
+
+/**
+ * Classifies a *synchronous* provider `send()` failure. Much stricter than the
+ * async path: a synchronous failure is usually the provider rejecting the request
+ * (throttling, auth, malformed payload) rather than the mailbox rejecting the
+ * message, so only unambiguous permanent-recipient signals suppress here.
+ */
+export function classifySuppressionFromSendFailure(error: string): SuppressionReason | null {
+  if (PERMANENT_SMTP_STATUS_CODES.some((pattern) => pattern.test(error))) return "hard_bounce";
+  if (/\b4\.\d+\.\d+\b/.test(error)) return null;
+  if (PERMANENT_BOUNCE_PHRASES.some((pattern) => pattern.test(error))) return "hard_bounce";
+
+  return null;
+}
+
+// `[\s\S]*` rather than the `s` (dotAll) flag: tsconfig targets ES2017.
+const DELIVERY_EVENT_MARKER = /^provider_event:(bounce|complaint|delivered):\s*([\s\S]*)$/;
+
+export function parseDeliveryEventMarker(lastError: string | null) {
+  if (!lastError) return null;
+
+  const match = DELIVERY_EVENT_MARKER.exec(lastError);
+  if (!match) return null;
+
+  return { kind: match[1] as "bounce" | "complaint" | "delivered", detail: match[2] ?? "" };
+}
+
+// ---------------------------------------------------------------------------
+// Suppression list — SQLite
+// ---------------------------------------------------------------------------
+
+export function suppressRecipient(db: AppDatabase, input: SuppressRecipientInput): boolean {
+  ensureSuppressionSchema(db);
+
+  const recipient = normalizeRecipient(input.recipient);
+  if (!recipient) return false;
+
+  const result = db.$client
+    .prepare(
+      `INSERT INTO notification_suppressions (recipient, reason, detail, source, created_at)
+       VALUES (?, ?, ?, ?, ?)
+       ON CONFLICT(recipient) DO NOTHING`,
+    )
+    .run(recipient, input.reason, input.detail ?? "", input.source ?? "", input.now);
+
+  return result.changes > 0;
+}
+
+export function isRecipientSuppressed(db: AppDatabase, recipient: string): boolean {
+  ensureSuppressionSchema(db);
+
+  const normalized = normalizeRecipient(recipient);
+  if (!normalized) return false;
+
+  const row = db.$client
+    .prepare("SELECT recipient FROM notification_suppressions WHERE recipient = ? LIMIT 1")
+    .get(normalized);
+
+  return Boolean(row);
+}
+
+export function listSuppressedRecipients(db: AppDatabase, recipients: string[]): Set<string> {
+  ensureSuppressionSchema(db);
+
+  const normalized = [...new Set(recipients.map(normalizeRecipient).filter(Boolean))];
+  if (normalized.length === 0) return new Set();
+
+  const placeholders = normalized.map(() => "?").join(", ");
+  const rows = db.$client
+    .prepare(`SELECT recipient FROM notification_suppressions WHERE recipient IN (${placeholders})`)
+    .all(...normalized) as { recipient: string }[];
+
+  return new Set(rows.map((row) => row.recipient));
+}
+
+export function listSuppressions(db: AppDatabase): SuppressionRecord[] {
+  ensureSuppressionSchema(db);
+
+  const rows = db.$client
+    .prepare(
+      `SELECT recipient, reason, detail, source, created_at AS createdAt
+       FROM notification_suppressions
+       ORDER BY created_at ASC, recipient ASC`,
+    )
+    .all() as SuppressionRecord[];
+
+  return rows;
+}
+
+export function removeSuppression(db: AppDatabase, recipient: string): boolean {
+  ensureSuppressionSchema(db);
+
+  const result = db.$client
+    .prepare("DELETE FROM notification_suppressions WHERE recipient = ?")
+    .run(normalizeRecipient(recipient));
+
+  return result.changes > 0;
+}
+
+/**
+ * Folds every bounce/complaint that a provider webhook already recorded on the
+ * outbox into the suppression list.
+ *
+ * The webhook routes (`app/api/notifications/webhooks/{ses,sendgrid}`) write the
+ * `provider_event:` marker via `outbox-repository.ts`; both of those files are
+ * owned by another workstream, so this reconcile pass is how those events reach
+ * the suppression list today. It runs at the top of every delivery tick, which
+ * means a bounced address is suppressed before the *next* send to it rather than
+ * at webhook-receipt time. See the follow-up note in `delivery.ts`.
+ */
+export function ingestOutboxDeliveryEventSuppressions(db: AppDatabase, now: string): number {
+  ensureSuppressionSchema(db);
+
+  const rows = db
+    .select({
+      id: notificationOutbox.id,
+      recipient: notificationOutbox.recipient,
+      lastError: notificationOutbox.lastError,
+    })
+    .from(notificationOutbox)
+    .where(like(notificationOutbox.lastError, "provider_event:%"))
+    .all();
+
+  let suppressed = 0;
+
+  for (const row of rows) {
+    const marker = parseDeliveryEventMarker(row.lastError);
+    if (!marker) continue;
+
+    const reason = classifySuppressionFromDeliveryEvent(marker.kind, marker.detail);
+    if (!reason) continue;
+
+    if (suppressRecipient(db, {
+      recipient: row.recipient,
+      reason,
+      detail: marker.detail,
+      source: row.id,
+      now,
+    })) {
+      suppressed += 1;
+    }
+  }
+
+  return suppressed;
+}
+
+// ---------------------------------------------------------------------------
+// Suppression list — MySQL
+// ---------------------------------------------------------------------------
+
+export async function suppressRecipientFromMysql(
+  mysql: MysqlSuppressionStore,
+  input: SuppressRecipientInput,
+): Promise<boolean> {
+  await ensureSuppressionSchemaFromMysql(mysql);
+
+  const recipient = normalizeRecipient(input.recipient);
+  if (!recipient) return false;
+
+  const result = await mysqlExecute(
+    mysql,
+    `INSERT INTO notification_suppressions (recipient, reason, detail, source, created_at)
+     VALUES (?, ?, ?, ?, ?)
+     ON DUPLICATE KEY UPDATE recipient = recipient`,
+    [recipient, input.reason, input.detail ?? "", input.source ?? "", input.now],
+  );
+
+  return result.affectedRows > 0;
+}
+
+export async function listSuppressedRecipientsFromMysql(
+  mysql: MysqlSuppressionStore,
+  recipients: string[],
+): Promise<Set<string>> {
+  await ensureSuppressionSchemaFromMysql(mysql);
+
+  const normalized = [...new Set(recipients.map(normalizeRecipient).filter(Boolean))];
+  if (normalized.length === 0) return new Set();
+
+  const placeholders = normalized.map(() => "?").join(", ");
+  const rows = await mysqlSelectMany<{ recipient: string }>(
+    mysql,
+    `SELECT recipient FROM notification_suppressions WHERE recipient IN (${placeholders})`,
+    normalized,
+  );
+
+  return new Set(rows.map((row) => normalizeRecipient(row.recipient)));
+}
+
+export async function ingestOutboxDeliveryEventSuppressionsFromMysql(
+  mysql: MysqlSuppressionStore,
+  now: string,
+): Promise<number> {
+  await ensureSuppressionSchemaFromMysql(mysql);
+
+  const rows = await mysqlSelectMany<{ id: string; recipient: string; lastError: string | null }>(
+    mysql,
+    `SELECT id, recipient, last_error AS lastError
+     FROM notification_outbox
+     WHERE last_error LIKE 'provider\\_event:%'`,
+  );
+
+  let suppressed = 0;
+
+  for (const row of rows) {
+    const marker = parseDeliveryEventMarker(row.lastError);
+    if (!marker) continue;
+
+    const reason = classifySuppressionFromDeliveryEvent(marker.kind, marker.detail);
+    if (!reason) continue;
+
+    const added = await suppressRecipientFromMysql(mysql, {
+      recipient: row.recipient,
+      reason,
+      detail: marker.detail,
+      source: row.id,
+      now,
+    });
+
+    if (added) suppressed += 1;
+  }
+
+  return suppressed;
+}
+
+// ---------------------------------------------------------------------------
+// Per-row delivery backoff
+// ---------------------------------------------------------------------------
+
+export function nextAttemptDelayMs(attemptCount: number, options: DeliveryBackoffOptions = {}) {
+  const baseDelayMs = options.baseDelayMs ?? DEFAULT_BACKOFF_BASE_DELAY_MS;
+  const maxDelayMs = options.maxDelayMs ?? DEFAULT_BACKOFF_MAX_DELAY_MS;
+  const exponent = Math.max(0, attemptCount - 1);
+
+  return Math.min(maxDelayMs, baseDelayMs * 2 ** exponent);
+}
+
+function nextAttemptAt(now: string, attemptCount: number, options: DeliveryBackoffOptions) {
+  const base = Date.parse(now);
+  const from = Number.isNaN(base) ? Date.now() : base;
+

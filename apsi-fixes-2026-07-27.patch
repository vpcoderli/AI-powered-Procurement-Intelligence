+    expect(legacyQuery(allBids, { q: "it services" })).toEqual(["1"]);
+    expect(tagOnly.bids).toEqual([]);
+  });
+
+  it("pages through the result set without dropping or repeating rows", async () => {
+    const unpaged = await queryBidsFromDatabase(testDb.db, { sort: "deadline" }, { referenceDate });
+    const collected: string[] = [];
+
+    for (let page = 1; page <= 3; page += 1) {
+      const response = await queryBidsFromDatabase(
+        testDb.db,
+        { sort: "deadline", page, pageSize: 2 },
+        { referenceDate },
+      );
+
+      expect(response.total).toBe(unpaged.total);
+      expect(response.pageSize).toBe(2);
+      expect(response.totalPages).toBe(3);
+      expect(response.page).toBe(page);
+      expect(response.hasMore).toBe(page < 3);
+      expect(response.bids).toHaveLength(2);
+      collected.push(...response.bids.map((bid) => bid.id));
+    }
+
+    expect(collected).toEqual(unpaged.bids.map((bid) => bid.id));
+  });
+
+  it("returns an empty page past the end without touching the bids table", async () => {
+    const response = await queryBidsFromDatabase(
+      testDb.db,
+      { page: 4, pageSize: 2 },
+      { referenceDate },
+    );
+
+    expect(response.bids).toEqual([]);
+    expect(response.total).toBe(6);
+    expect(response.hasMore).toBe(false);
+  });
+
+  it("handles a page size larger than the result set", async () => {
+    const response = await queryBidsFromDatabase(
+      testDb.db,
+      { page: 1, pageSize: 200 },
+      { referenceDate },
+    );

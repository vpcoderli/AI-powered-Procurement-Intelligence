@@ -0,0 +1,38 @@
+"""Shared, compliance-enforcing HTTP layer.
+
+Spiders must not call ``requests`` directly. They obtain a transport from
+:func:`open_client`, which applies honest identification (D1), refuses browser
+impersonation (D2), obeys robots.txt (D3) and rate-limits per origin (D4).
+"""
+
+from apsi_crawler.net.approval import (
+    approved_source_ids,
+    is_source_approved,
+    require_source_approved,
+)
+from apsi_crawler.net.client import PoliteSession, open_client, sanitize_headers
+from apsi_crawler.net.errors import (
+    RobotsDisallowedError,
+    RobotsUnavailableError,
+    SourceBlockedError,
+    SourceNotApprovedError,
+    SourceRequiresLegalReviewError,
+)
+from apsi_crawler.net.identity import default_headers, user_agent
+
+
+__all__ = [
+    "PoliteSession",
+    "RobotsDisallowedError",
+    "RobotsUnavailableError",
+    "SourceBlockedError",
+    "SourceNotApprovedError",
+    "SourceRequiresLegalReviewError",
+    "approved_source_ids",
+    "default_headers",
+    "is_source_approved",
+    "open_client",
+    "require_source_approved",
+    "sanitize_headers",
+    "user_agent",
+]
diff --git a/crawler/apsi_crawler/net/approval.py b/crawler/apsi_crawler/net/approval.py
new file mode 100644
index 0000000..34c73ef
--- /dev/null
+++ b/crawler/apsi_crawler/net/approval.py
@@ -0,0 +1,77 @@
+"""Ingestion kill switch (D5) -- default deny.
+
+Why an allowlist rather than a direct database read
+---------------------------------------------------
+The authoritative ``data_sources.is_enabled`` / ``approved_for_ingestion``
+columns live in the frontend's database: SQLite in development, MySQL in
+production. Reading them from Python would mean shipping a MySQL driver (the
+crawler's ``requirements.txt`` is ``requests`` + ``pytest`` only), teaching the
+crawler a second set of connection secrets, and coupling it to a schema owned
+by another service. That is a lot of new surface for a control that has to be
+trustworthy under legal pressure.
+
+So the crawler takes the allowlist as *input*: the caller (the frontend worker,
+which already has the database open) passes the ids it has confirmed are
+enabled and approved, via ``--approved-source`` or ``APSI_APPROVED_SOURCE_IDS``.
+Turning a source off is then a data change in the frontend plus the next worker
+tick -- no redeploy -- which is the property that matters when a cease-and-desist
+arrives.
+
+Default is **deny**: with no allowlist configured, nothing is crawled.
+``APSI_APPROVE_ALL_SOURCES=1`` is an explicit, deliberately noisy development
+escape hatch -- it is never the default.
+"""
+
+import os
+
+from apsi_crawler.net.errors import SourceNotApprovedError
+
+
+APPROVED_SOURCE_IDS_ENV = "APSI_APPROVED_SOURCE_IDS"
+APPROVE_ALL_ENV = "APSI_APPROVE_ALL_SOURCES"
+
+
+def _split_ids(raw):
+    if not raw:
+        return frozenset()
+    if isinstance(raw, str):
+        parts = raw.replace("\n", ",").split(",")
+    else:
+        parts = list(raw)
+    return frozenset(part.strip() for part in parts if str(part).strip())
+
+
+def approve_all_enabled():
+    return (os.environ.get(APPROVE_ALL_ENV) or "").strip().lower() in ("1", "true", "yes", "on")
+
+
+def approved_source_ids(explicit=None):
+    """Ids the operator has cleared for ingestion, from CLI args then environment."""
+    if explicit is not None:
+        return _split_ids(explicit)
+    return _split_ids(os.environ.get(APPROVED_SOURCE_IDS_ENV))
+
+
+def is_source_approved(source, approved=None):
+    source_id = getattr(source, "id", source)
+
+    if approve_all_enabled():
+        return True
+    if getattr(source, "approved_for_ingestion", False):
+        return True
+    return source_id in approved_source_ids(approved)
+
+
+def require_source_approved(source, approved=None):
+    """Raise unless the source is on the operator's allowlist. Default deny."""
+    source_id = getattr(source, "id", source)
+    if is_source_approved(source, approved=approved):
+        return
+
+    raise SourceNotApprovedError(
+        f"Source '{source_id}' is not approved for ingestion. The crawler denies by "
+        f"default; pass --approved-source {source_id} or set "
+        f"{APPROVED_SOURCE_IDS_ENV} from the frontend's data_sources table "
+        f"(is_enabled AND approved_for_ingestion).",
+        source_id=source_id,
+    )
diff --git a/crawler/apsi_crawler/net/client.py b/crawler/apsi_crawler/net/client.py
new file mode 100644
index 0000000..96ff467
--- /dev/null
+++ b/crawler/apsi_crawler/net/client.py
@@ -0,0 +1,163 @@
+"""The single outbound HTTP entry point for every spider.
+
+``PoliteSession`` wraps whatever transport a caller supplies (a real
+``requests.Session`` in production, a fake in tests) and applies, on every
+request:
+
+1. D1 -- our honest ``User-Agent`` / ``From`` identity, which callers cannot
+   override.
+2. D2 -- browser-impersonation headers are stripped. ``Referer``, ``Origin``,
+   ``X-Requested-With``, ``Cookie`` and the ``Sec-*`` family exist to make an
+   automated request look like it came from a human clicking inside a page. If
+   an endpoint only answers when those are present, the operator of that
+   endpoint does not want automated access; the right outcome is a failed fetch
+   and a "source blocked / requires review" signal, not a better disguise.
+3. D3 -- robots.txt is consulted (and cached) before the request is made.
+4. D4 -- per-origin serialisation, a minimum delay, and 429/503 backoff.
+"""
+
+import requests
+
+from apsi_crawler.net import config, identity
+from apsi_crawler.net import robots as robots_module
+from apsi_crawler.net import throttle as throttle_module
+
+
+#: Headers a caller may never set. They are the mechanics of pretending to be a
+#: browser session rather than a self-identified robot.
+IMPERSONATION_HEADERS = frozenset(
+    {
+        "user-agent",
+        "referer",
+        "referrer",
+        "origin",
+        "x-requested-with",
+        "cookie",
+    }
+)
+
+IMPERSONATION_HEADER_PREFIXES = ("sec-fetch-", "sec-ch-")
+
+
+def sanitize_headers(headers):
+    """Merge caller headers onto our identity, dropping impersonation headers."""
+    merged = identity.default_headers()
+    for name, value in (headers or {}).items():
+        lowered = str(name).strip().lower()
+        if lowered in IMPERSONATION_HEADERS:
+            continue
+        if lowered.startswith(IMPERSONATION_HEADER_PREFIXES):
+            continue
+        merged[name] = value
+    return merged
+
+
+class PoliteSession:
+    """Compliance wrapper around a ``requests``-like transport."""
+
+    def __init__(
+        self,
+        transport=None,
+        owns_transport=False,
+        robots=None,
+        throttle=None,
+        source_id=None,
+        delay_profile=config.PAGE_PROFILE,
+    ):
+        self._transport = transport if transport is not None else requests.Session()
+        self._owns_transport = owns_transport or transport is None
+        self._robots = robots
+        self._throttle = throttle
+        self.source_id = source_id
+        self.delay_profile = delay_profile
+
+    @property
+    def transport(self):
+        return self._transport
+
+    @property
+    def robots(self):
+        return self._robots or robots_module.default_cache()
+
+    @property
+    def throttle(self):
+        return self._throttle or throttle_module.default_throttle()
+
+    def get(self, url, **kwargs):
+        return self._request("get", url, **kwargs)
+
+    def post(self, url, **kwargs):
+        return self._request("post", url, **kwargs)
+
+    def _request(self, method, url, **kwargs):
+        kwargs["headers"] = sanitize_headers(kwargs.get("headers"))
+
+        # D3: ask permission before every request. Raises SourceBlockedError
+        # subclasses, which callers must let propagate rather than retry.
+        crawl_delay = self.robots.check(
+            url,
+            user_agent=identity.robots_user_agent(),
+            source_id=self.source_id,
+        )
+
+        send = getattr(self._transport, method)
+        attempts = config.max_retries() + 1
+        response = None
+
+        for attempt in range(attempts):
+            # D4: serialise per origin and wait out the minimum delay.
+            release = self.throttle.acquire(url, crawl_delay=crawl_delay, profile=self.delay_profile)
+            try:
+                response = send(url, **kwargs)
+            finally:
+                release()
+
+            status_code = getattr(response, "status_code", None)
+            if status_code not in throttle_module.RETRYABLE_STATUS_CODES:
+                return response
+            if attempt == attempts - 1:
+                break
+
+            retry_after = throttle_module.parse_retry_after(
+                (getattr(response, "headers", None) or {}).get("Retry-After")
+            )
+            self.throttle.backoff(
+                attempt,
+                retry_after=retry_after,
+                crawl_delay=crawl_delay,
+                profile=self.delay_profile,
+            )
+
+        # Retries exhausted. Hand the final 429/503 back to the caller so it can
+        # raise its own descriptive error; we do not disguise the request and try
+        # again, because the origin has explicitly asked us to stop.
+        return response
+
+    def close(self):
+        if self._owns_transport:
+            self._transport.close()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+        return False
+
+
+def open_client(session=None, source_id=None, delay_profile=config.PAGE_PROFILE):
+    """Return a :class:`PoliteSession` for a spider.
+
+    ``session`` is the transport a caller injected (tests, or a caller that
+    wants connection reuse). When it is ``None`` we create -- and later close --
+    our own. Either way the compliance layer is applied; there is no code path
+    that reaches the network without it.
+    """
+    if isinstance(session, PoliteSession):
+        return session
+    return PoliteSession(
+        transport=session,
+        owns_transport=session is None,
+        source_id=source_id,
+        delay_profile=delay_profile,
+    )
diff --git a/crawler/apsi_crawler/net/config.py b/crawler/apsi_crawler/net/config.py
new file mode 100644
index 0000000..db1663b
--- /dev/null
+++ b/crawler/apsi_crawler/net/config.py
@@ -0,0 +1,113 @@
+"""Environment-driven knobs for the polite HTTP layer.
+
+Everything is read at call time (not import time) so tests and operators can
+change behaviour with ``monkeypatch.setenv`` / a restart-free config reload.
+"""
+
+import os
+
+
+ROBOTS_ENABLED_ENV = "APSI_ROBOTS_ENABLED"
+ROBOTS_FAIL_OPEN_ENV = "APSI_ROBOTS_FAIL_OPEN"
+ROBOTS_TIMEOUT_ENV = "APSI_ROBOTS_TIMEOUT_SECONDS"
+ROBOTS_CACHE_TTL_ENV = "APSI_ROBOTS_CACHE_TTL_SECONDS"
+
+MIN_DELAY_ENV = "APSI_CRAWL_MIN_DELAY_SECONDS"
+MAX_DELAY_ENV = "APSI_CRAWL_MAX_DELAY_SECONDS"
+ASSET_MIN_DELAY_ENV = "APSI_CRAWL_ASSET_MIN_DELAY_SECONDS"
+ASSET_MAX_DELAY_ENV = "APSI_CRAWL_ASSET_MAX_DELAY_SECONDS"
+MAX_CONCURRENCY_ENV = "APSI_CRAWL_MAX_CONCURRENCY"
+MAX_RETRIES_ENV = "APSI_CRAWL_MAX_RETRIES"
+MAX_RETRY_AFTER_ENV = "APSI_CRAWL_MAX_RETRY_AFTER_SECONDS"
+
+# Same-origin requests are serialised and separated by at least this many
+# seconds. 2-5s with jitter keeps a single host well under 1 request/second
+# even when 19 source adapters share one domain, while still letting a full
+# ~50 source sweep finish in minutes because different domains run in parallel.
+DEFAULT_MIN_DELAY_SECONDS = 2.0
+DEFAULT_MAX_DELAY_SECONDS = 5.0
+
+# Downloading the documents a listing we were just served points at is a
+# different kind of load from crawling for new pages, and applying the full 2-5s
+# page delay to every attachment would push a 50-source sweep past the worker's
+# 15-minute tick. These fetches are still serialised per origin, still capped at
+# well under two requests a second, and a robots.txt Crawl-delay larger than this
+# still wins.
+DEFAULT_ASSET_MIN_DELAY_SECONDS = 0.5
+DEFAULT_ASSET_MAX_DELAY_SECONDS = 1.5
+# Distinct origins that may be in flight at the same time.
+DEFAULT_MAX_CONCURRENCY = 4
+DEFAULT_MAX_RETRIES = 2
+DEFAULT_MAX_RETRY_AFTER_SECONDS = 120.0
+DEFAULT_ROBOTS_TIMEOUT_SECONDS = 10.0
+DEFAULT_ROBOTS_CACHE_TTL_SECONDS = 3600.0
+
+
+def _flag(name, default):
+    raw = (os.environ.get(name) or "").strip().lower()
+    if not raw:
+        return default
+    return raw in ("1", "true", "yes", "on")
+
+
+def _number(name, default, minimum=0.0):
+    raw = (os.environ.get(name) or "").strip()
+    if not raw:
+        return default
+    try:
+        value = float(raw)
+    except ValueError:
+        return default
+    return max(minimum, value)
+
+
+def _integer(name, default, minimum=0):
+    return max(minimum, int(_number(name, default, minimum=minimum)))
+
+
+def robots_enabled():
+    return _flag(ROBOTS_ENABLED_ENV, True)
+
+
+def robots_fail_open():
+    return _flag(ROBOTS_FAIL_OPEN_ENV, False)
+
+
+def robots_timeout_seconds():
+    return _number(ROBOTS_TIMEOUT_ENV, DEFAULT_ROBOTS_TIMEOUT_SECONDS, minimum=1.0)
+
+
+def robots_cache_ttl_seconds():
+    return _number(ROBOTS_CACHE_TTL_ENV, DEFAULT_ROBOTS_CACHE_TTL_SECONDS, minimum=0.0)
+
+
+#: Delay profiles: "page" for crawling, "asset" for retrieving linked documents.
+PAGE_PROFILE = "page"
+ASSET_PROFILE = "asset"
+
+
+def min_delay_seconds(profile=PAGE_PROFILE):
+    if profile == ASSET_PROFILE:
+        return _number(ASSET_MIN_DELAY_ENV, DEFAULT_ASSET_MIN_DELAY_SECONDS)
+    return _number(MIN_DELAY_ENV, DEFAULT_MIN_DELAY_SECONDS)
+
+
+def max_delay_seconds(profile=PAGE_PROFILE):
+    if profile == ASSET_PROFILE:
+        return max(
+            min_delay_seconds(profile),
+            _number(ASSET_MAX_DELAY_ENV, DEFAULT_ASSET_MAX_DELAY_SECONDS),
+        )
+    return max(min_delay_seconds(profile), _number(MAX_DELAY_ENV, DEFAULT_MAX_DELAY_SECONDS))
+
+
+def max_concurrency():
+    return _integer(MAX_CONCURRENCY_ENV, DEFAULT_MAX_CONCURRENCY, minimum=1)
+
+
+def max_retries():
+    return _integer(MAX_RETRIES_ENV, DEFAULT_MAX_RETRIES, minimum=0)
+
+
+def max_retry_after_seconds():
+    return _number(MAX_RETRY_AFTER_ENV, DEFAULT_MAX_RETRY_AFTER_SECONDS, minimum=0.0)
diff --git a/crawler/apsi_crawler/net/errors.py b/crawler/apsi_crawler/net/errors.py
new file mode 100644
index 0000000..b69c278
--- /dev/null
+++ b/crawler/apsi_crawler/net/errors.py
@@ -0,0 +1,53 @@
+"""Compliance errors raised instead of working around an access restriction.
+
+These are deliberately *not* recoverable inside the crawler. When a site tells
+us (via robots.txt, a login wall, or an unreviewed legal status) that automated
+access is not welcome, the correct behaviour is to stop and surface a clear
+"source blocked / requires review" signal to the operator -- never to retry with
+different headers or a different identity.
+"""
+
+
+class SourceBlockedError(Exception):
+    """Base class for 'we are not permitted to fetch this' conditions."""
+
+    reason_code = "source_blocked"
+
+    def __init__(self, message, source_id=None, url=None):
+        super().__init__(message)
+        self.source_id = source_id
+        self.url = url
+
+    def as_metadata(self):
+        return {
+            "blocked": True,
+            "reasonCode": self.reason_code,
+            "reason": str(self),
+            "source": self.source_id,
+            "url": self.url,
+            "requiresReview": True,
+        }
+
+
+class RobotsDisallowedError(SourceBlockedError):
+    """robots.txt for the target origin disallows this path for our user agent."""
+
+    reason_code = "robots_disallowed"
+
+
+class RobotsUnavailableError(SourceBlockedError):
+    """robots.txt could not be retrieved, so we must assume we are not allowed."""
+
+    reason_code = "robots_unavailable"
+
+
+class SourceNotApprovedError(SourceBlockedError):
+    """The source is not on the operator-approved ingestion allowlist (kill switch)."""
+
+    reason_code = "source_not_approved"
+
+
+class SourceRequiresLegalReviewError(SourceBlockedError):
+    """The source's terms-of-service / licensing status has not been cleared."""
+
+    reason_code = "source_requires_legal_review"
diff --git a/crawler/apsi_crawler/net/identity.py b/crawler/apsi_crawler/net/identity.py
new file mode 100644
index 0000000..38ec46e
--- /dev/null
+++ b/crawler/apsi_crawler/net/identity.py
@@ -0,0 +1,65 @@
+"""Honest crawler identity (D1).
+
+Every outbound request this crawler makes must identify itself truthfully:
+a stable product token, a URL describing the bot, and a working contact
+address a site operator can use to reach us. Impersonating a consumer
+browser (``Mozilla/5.0 ... Chrome/...``) hides that a robot is responsible
+for the traffic, removes the operator's ability to contact us, and is the
+behaviour that turns an ordinary crawl into an abuse complaint.
+
+The domain and mailbox are read from the environment so a deployment can
+point them at real, monitored resources without a code change.
+"""
+
+import os
+
+
+BOT_VERSION = "1.0"
+BOT_PRODUCT_TOKEN = "APSiBot"
+
+# TODO(ops): replace these defaults with the real production domain and a
+# monitored mailbox before the crawler runs against live sources. The
+# defaults deliberately use a non-routable example domain so that an
+# unconfigured deployment is obviously unconfigured rather than silently
+# advertising a contact nobody reads.
+DEFAULT_BOT_DOMAIN = "apsi.example.org"
+DEFAULT_BOT_CONTACT_EMAIL = "ops@apsi.example.org"
+
+BOT_DOMAIN_ENV = "APSI_BOT_DOMAIN"
+BOT_CONTACT_EMAIL_ENV = "APSI_BOT_CONTACT_EMAIL"
+
+
+def _env(name, default):
+    value = (os.environ.get(name) or "").strip()
+    return value or default
+
+
+def bot_domain():
+    return _env(BOT_DOMAIN_ENV, DEFAULT_BOT_DOMAIN)
+
+
+def bot_contact_email():
+    return _env(BOT_CONTACT_EMAIL_ENV, DEFAULT_BOT_CONTACT_EMAIL)
+
+
+def bot_info_url():
+    """Page describing who runs the crawler, what it collects and how to opt out."""
+    return f"https://{bot_domain()}/bot"
+
+
+def user_agent():
+    """The single User-Agent string used for every outbound request."""
+    return f"{BOT_PRODUCT_TOKEN}/{BOT_VERSION} (+{bot_info_url()}; {bot_contact_email()})"
+
+
+def robots_user_agent():
+    """Token used to select our group in robots.txt."""
+    return BOT_PRODUCT_TOKEN
+
+
+def default_headers():
+    """Identity headers merged into every request made through the polite layer."""
+    return {
+        "User-Agent": user_agent(),
+        "From": bot_contact_email(),
+    }
diff --git a/crawler/apsi_crawler/net/robots.py b/crawler/apsi_crawler/net/robots.py
new file mode 100644
index 0000000..da097e7
--- /dev/null
+++ b/crawler/apsi_crawler/net/robots.py
@@ -0,0 +1,208 @@
+"""robots.txt fetching, parsing, caching and enforcement (D3).
+
+Uses only the standard library (``urllib.robotparser``) plus ``requests`` for
+the fetch, so no new dependency is introduced.
+
+Fetch semantics follow RFC 9309 with one deliberate deviation:
+
+* ``2xx``  -> parse and apply the rules.
+* ``4xx``  -> "unavailable"; RFC 9309 permits unrestricted access. We allow.
+* ``5xx``  -> "unreachable"; RFC 9309 says assume complete disallow. We disallow.
+* network error / timeout -> we **disallow** (fail closed).
+
+The deviation is the last one: a transport failure is treated like an
+unreachable robots.txt rather than an implicit permission. For a crawler whose
+legal exposure is the main risk, silently crawling a host whose rules we could
+not read is the wrong default. Set ``APSI_ROBOTS_FAIL_OPEN=1`` to invert it if
+an operator consciously accepts that risk.
+"""
+
+import threading
+import time
+from urllib.parse import urlsplit, urlunsplit
+from urllib.robotparser import RobotFileParser
+
+import requests
+
+from apsi_crawler.net import identity
+from apsi_crawler.net.config import (
+    robots_cache_ttl_seconds,
+    robots_enabled,
+    robots_fail_open,
+    robots_timeout_seconds,
+)
+from apsi_crawler.net.errors import RobotsDisallowedError, RobotsUnavailableError
+
+
+ALLOW_ALL = "allow_all"
+DISALLOW_ALL = "disallow_all"
+
+
+def origin_of(url):
+    parts = urlsplit(url)
+    return urlunsplit((parts.scheme, parts.netloc, "", "", ""))
+
+
+def robots_url_for(url):
+    parts = urlsplit(url)
+    return urlunsplit((parts.scheme, parts.netloc, "/robots.txt", "", ""))
+
+
+def _path_of(url):
+    parts = urlsplit(url)
+    path = parts.path or "/"
+    if parts.query:
+        path = f"{path}?{parts.query}"
+    return path
+
+
+class RobotsPolicy:
+    """Parsed rules for one origin."""
+
+    def __init__(self, origin, robots_text=None, mode=None, fetched_at=None):
+        self.origin = origin
+        self.mode = mode
+        self.fetched_at = fetched_at if fetched_at is not None else time.time()
+        self._parser = None
+        if mode is None:
+            self._parser = RobotFileParser()
+            self._parser.set_url(robots_url_for(origin + "/"))
+            self._parser.parse((robots_text or "").splitlines())
+
+    def allows(self, url, user_agent):
+        if self.mode == ALLOW_ALL:
+            return True
+        if self.mode == DISALLOW_ALL:
+            return False
+        return bool(self._parser.can_fetch(user_agent, _path_of(url)))
+
+    def crawl_delay(self, user_agent):
+        if self._parser is None:
+            return None
+        try:
+            delay = self._parser.crawl_delay(user_agent)
+        except Exception:
+            return None
+        if delay in (None, ""):
+            return None
+        try:
+            return float(delay)
+        except (TypeError, ValueError):
+            return None
+
+
+def _default_fetcher(url, timeout):
+    """Fetch robots.txt with our honest identity, outside the normal throttle.
+
+    robots.txt is intentionally fetched on a private session: it must never
+    inherit cookies, referers or session state from a spider's transport.
+    """
+    session = requests.Session()
+    try:
+        response = session.get(
+            url,
+            headers={**identity.default_headers(), "Accept": "text/plain,*/*"},
+            timeout=timeout,
+            allow_redirects=True,
+        )
+        return response.status_code, response.text
+    finally:
+        session.close()
+
+
+class RobotsCache:
+    """Per-origin robots.txt cache with a TTL.
+
+    ``fetcher`` is the dependency-injection seam: it takes ``(url, timeout)``
+    and returns ``(status_code, text)``. Tests inject a fetcher so no real
+    network request is ever made.
+    """
+
+    def __init__(self, fetcher=None, timeout=None, ttl_seconds=None, clock=time.monotonic):
+        self._fetcher = fetcher or _default_fetcher
+        self._timeout = timeout
+        self._ttl = ttl_seconds
+        self._clock = clock
+        self._lock = threading.Lock()
+        self._entries = {}
+
+    @property
+    def ttl_seconds(self):
+        return robots_cache_ttl_seconds() if self._ttl is None else self._ttl
+
+    @property
+    def timeout_seconds(self):
+        return robots_timeout_seconds() if self._timeout is None else self._timeout
+
+    def seed(self, origin, robots_text=None, mode=None):
+        """Install a policy without any network access (used by tests/ops tooling)."""
+        origin = origin_of(origin) if "://" in origin else origin
+        policy = RobotsPolicy(origin, robots_text=robots_text, mode=mode)
+        with self._lock:
+            self._entries[origin] = (self._clock(), policy)
+        return policy
+
+    def clear(self):
+        with self._lock:
+            self._entries.clear()
+
+    def policy_for(self, url):
+        origin = origin_of(url)
+        now = self._clock()
+        with self._lock:
+            entry = self._entries.get(origin)
+            if entry is not None and (now - entry[0]) < self.ttl_seconds:
+                return entry[1]
+
+        policy = self._load_policy(origin)
+
+        with self._lock:
+            self._entries[origin] = (self._clock(), policy)
+        return policy
+
+    def _load_policy(self, origin):
+        try:
+            status_code, text = self._fetcher(robots_url_for(origin + "/"), self.timeout_seconds)
+        except Exception:
+            mode = ALLOW_ALL if robots_fail_open() else DISALLOW_ALL
+            return RobotsPolicy(origin, mode=mode)
+
+        if 200 <= int(status_code) < 300:
+            return RobotsPolicy(origin, robots_text=text or "")
+        if 400 <= int(status_code) < 500:
+            # "Unavailable" per RFC 9309: no rules published, access permitted.
+            return RobotsPolicy(origin, mode=ALLOW_ALL)
+        # 5xx and anything else: treat the site as unreadable, therefore off limits.
+        return RobotsPolicy(origin, mode=ALLOW_ALL if robots_fail_open() else DISALLOW_ALL)
+
+    def check(self, url, user_agent=None, source_id=None):
+        """Return the crawl delay for ``url`` or raise if we must not fetch it."""
+        if not robots_enabled():
+            return None
+
+        agent = user_agent or identity.robots_user_agent()
+        policy = self.policy_for(url)
+
+        if not policy.allows(url, agent):
+            if policy.mode == DISALLOW_ALL:
+                raise RobotsUnavailableError(
+                    f"robots.txt for {origin_of(url)} could not be read; refusing to crawl "
+                    f"(source blocked / requires review)",
+                    source_id=source_id,
+                    url=url,
+                )
+            raise RobotsDisallowedError(
+                f"robots.txt for {origin_of(url)} disallows {agent} on {_path_of(url)} "
+                f"(source blocked / requires review)",
+                source_id=source_id,
+                url=url,
+            )
+
+        return policy.crawl_delay(agent)
+
+
+_DEFAULT_CACHE = RobotsCache()
+
+
+def default_cache():
+    return _DEFAULT_CACHE
diff --git a/crawler/apsi_crawler/net/throttle.py b/crawler/apsi_crawler/net/throttle.py
new file mode 100644
index 0000000..b21b5f5
--- /dev/null
+++ b/crawler/apsi_crawler/net/throttle.py
@@ -0,0 +1,154 @@
+"""Per-origin rate limiting, serialisation and backoff (D4).
+
+Guarantees provided to every request that goes through ``PoliteSession``:
+
+* **Same origin is serialised.** Only one request per host is in flight at a
+  time, so a burst of adapters that happen to share a domain (e.g. the 19
+  BidNet state adapters) cannot fan out into a hammering pattern.
+* **A minimum gap between same-origin requests.** ``APSI_CRAWL_MIN_DELAY_SECONDS``
+  to ``APSI_CRAWL_MAX_DELAY_SECONDS`` (default 2-5s, jittered), raised to the
+  origin's robots.txt ``Crawl-delay`` whenever that is larger.
+* **A global concurrency ceiling** across all origins
+  (``APSI_CRAWL_MAX_CONCURRENCY``, default 4) so a full sweep is parallel
+  across domains but never unbounded.
+* **Backoff on 429 / 503**, honouring ``Retry-After`` (delta-seconds or
+  HTTP-date), capped by ``APSI_CRAWL_MAX_RETRY_AFTER_SECONDS``.
+"""
+
+import random
+import threading
+import time
+from email.utils import parsedate_to_datetime
+
+from apsi_crawler.net import config
+from apsi_crawler.net.robots import origin_of
+
+
+RETRYABLE_STATUS_CODES = (429, 503)
+
+
+def parse_retry_after(value, now=None):
+    """Return ``Retry-After`` as seconds, or ``None`` if it is absent/unparseable."""
+    if value in (None, ""):
+        return None
+
+    raw = str(value).strip()
+    try:
+        return max(0.0, float(raw))
+    except ValueError:
+        pass
+
+    try:
+        target = parsedate_to_datetime(raw)
+    except (TypeError, ValueError):
+        return None
+    if target is None:
+        return None
+
+    reference = now if now is not None else time.time()
+    if target.tzinfo is None:
+        seconds = target.timestamp() - reference
+    else:
+        seconds = target.timestamp() - reference
+    return max(0.0, seconds)
+
+
+class _OriginState:
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.next_allowed_at = 0.0
+
+
+class DomainThrottle:
+    """Shared throttle. One instance is used process-wide by default."""
+
+    def __init__(self, clock=time.monotonic, sleeper=time.sleep, rng=None, max_concurrency=None):
+        self._clock = clock
+        self._sleep = sleeper
+        self._rng = rng or random.Random()
+        self._registry_lock = threading.Lock()
+        self._origins = {}
+        self._configured_concurrency = max_concurrency
+        self._semaphore = None
+        self._semaphore_size = None
+
+    def _origin_state(self, origin):
+        with self._registry_lock:
+            state = self._origins.get(origin)
+            if state is None:
+                state = _OriginState()
+                self._origins[origin] = state
+            return state
+
+    def _concurrency_slot(self):
+        size = self._configured_concurrency or config.max_concurrency()
+        with self._registry_lock:
+            if self._semaphore is None or self._semaphore_size != size:
+                self._semaphore = threading.BoundedSemaphore(size)
+                self._semaphore_size = size
+            return self._semaphore
+
+    def _base_delay(self, profile=config.PAGE_PROFILE):
+        minimum = config.min_delay_seconds(profile)
+        maximum = config.max_delay_seconds(profile)
+        if maximum <= minimum:
+            return minimum
+        return self._rng.uniform(minimum, maximum)
+
+    def delay_for(self, crawl_delay=None, profile=config.PAGE_PROFILE):
+        """Effective gap: the configured jittered delay, or robots Crawl-delay if larger."""
+        delay = self._base_delay(profile)
+        if crawl_delay:
+            delay = max(delay, float(crawl_delay))
+        return delay
+
+    def acquire(self, url, crawl_delay=None, profile=config.PAGE_PROFILE):
+        """Block until it is polite to hit ``url``. Returns a release callable."""
+        origin = origin_of(url)
+        semaphore = self._concurrency_slot()
+        semaphore.acquire()
+        state = self._origin_state(origin)
+        state.lock.acquire()
+
+        try:
+            wait = state.next_allowed_at - self._clock()
+            if wait > 0:
+                self._sleep(wait)
+        except BaseException:
+            state.lock.release()
+            semaphore.release()
+            raise
+
+        delay = self.delay_for(crawl_delay, profile=profile)
+
+        def release(extra_wait=0.0):
+            state.next_allowed_at = self._clock() + max(delay, float(extra_wait or 0.0))
+            state.lock.release()
+            semaphore.release()
+
+        return release
+
+    def backoff(self, attempt, retry_after=None, crawl_delay=None, profile=config.PAGE_PROFILE):
+        """Sleep before retrying a 429/503 and return the number of seconds slept."""
+        cap = config.max_retry_after_seconds()
+        if retry_after is not None:
+            seconds = min(float(retry_after), cap)
+        else:
+            base = self.delay_for(crawl_delay, profile=profile)
+            seconds = min(base * (2 ** max(0, attempt)), cap)
+        if seconds > 0:
+            self._sleep(seconds)
+        return seconds
+
+    def reset(self):
+        with self._registry_lock:
+            self._origins.clear()
+            self._semaphore = None
+            self._semaphore_size = None
+
+
+_DEFAULT_THROTTLE = DomainThrottle()
+
+
+def default_throttle():
+    return _DEFAULT_THROTTLE

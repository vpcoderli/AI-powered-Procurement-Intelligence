+      const expected = legacyQuery(allBids, query);
+      const actual = await queryBidsFromDatabase(testDb.db, query, { referenceDate });
+
+      expect(actual.bids.map((bid) => bid.id)).toEqual(expected);
+      expect(actual.total).toBe(expected.length);
+    },
+  );
+
+  it("keeps hydrating attachments, tags and saved state for the rows it returns", async () => {
+    const result = await queryBidsFromDatabase(testDb.db, { q: "cloud" }, { referenceDate });
+
+    expect(result.bids[0]).toMatchObject({
+      id: "1",
+      title: "Enterprise Cloud Migration Services",
+      tags: ["IT Services", "Cloud", "Federal"],
+    });
+    expect(result.bids[0].attachments.map((attachment) => attachment.name)).toContain(
+      "Statement_of_Work_v2.pdf",
+    );
+  });
+
+  it("does not match keywords that only exist in raw_payload tags", async () => {
+    // Documented gap of the LIKE pushdown: `tags` live inside the raw_payload
+    // JSON blob and are not indexed. Matching the blob would make every keyword
+    // hit unrelated rows, so tag-only matches wait for the full-text index.
+    const allBids = await listBids(testDb.db);
+    const tagOnly = await queryBidsFromDatabase(testDb.db, { q: "it services" }, { referenceDate });

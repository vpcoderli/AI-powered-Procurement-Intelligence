+import { describe, expect, it } from "vitest";
+import { isDevelopmentBypassEnabled, isFlagEnabled, isProductionLikeRuntime } from "./runtime-env";
+
+describe("isProductionLikeRuntime", () => {
+  it("treats an empty environment as non-production", () => {
+    expect(isProductionLikeRuntime({})).toBe(false);
+  });
+
+  it.each([
+    ["NODE_ENV", "production"],
+    ["APP_ENV", "production"],
+    ["DEPLOY_ENV", "prod"],
+    ["VERCEL_ENV", "production"],
+    ["RUNTIME_ENV", "prod"],
+  ])("detects production from %s alone", (key, value) => {
+    expect(isProductionLikeRuntime({ [key]: value })).toBe(true);
+  });
+
+  it("still detects production when NODE_ENV is missing entirely", () => {
+    // The whole point of the shared helper: losing NODE_ENV must not silently
+    // re-open every security bypass at once.
+    expect(isProductionLikeRuntime({ APP_ENV: "production" })).toBe(true);
+    expect(isProductionLikeRuntime({ NODE_ENV: "development", DEPLOY_ENV: "prod" })).toBe(true);
+  });
+
+  it("normalizes casing and surrounding whitespace", () => {
+    expect(isProductionLikeRuntime({ APP_ENV: "  PRODUCTION " })).toBe(true);
+    expect(isProductionLikeRuntime({ DEPLOY_ENV: "Prod" })).toBe(true);
+  });
+
+  it("does not treat staging, preview, or test as production", () => {
+    expect(isProductionLikeRuntime({ APP_ENV: "staging" })).toBe(false);
+    expect(isProductionLikeRuntime({ VERCEL_ENV: "preview" })).toBe(false);
+    expect(isProductionLikeRuntime({ NODE_ENV: "test" })).toBe(false);
+  });
+});
+
+describe("isFlagEnabled", () => {
+  it("is off by default", () => {
+    expect(isFlagEnabled(undefined)).toBe(false);
+    expect(isFlagEnabled("")).toBe(false);
+    expect(isFlagEnabled("  ")).toBe(false);
+  });
+
+  it.each(["1", "true", "TRUE", " yes ", "on"])("accepts %s as enabled", (value) => {
+    expect(isFlagEnabled(value)).toBe(true);
+  });
+
+  it.each(["0", "false", "no", "off", "maybe"])("rejects %s", (value) => {
+    expect(isFlagEnabled(value)).toBe(false);
+  });
+});
+
+describe("isDevelopmentBypassEnabled", () => {
+  it("requires both a non-production runtime and an explicit opt-in", () => {
+    expect(isDevelopmentBypassEnabled("BYPASS", { NODE_ENV: "development", BYPASS: "true" })).toBe(true);
+    expect(isDevelopmentBypassEnabled("BYPASS", { NODE_ENV: "development" })).toBe(false);
+    expect(isDevelopmentBypassEnabled("BYPASS", { NODE_ENV: "production", BYPASS: "true" })).toBe(false);
+  });
+
+  it("stays closed when any single env var marks the runtime production-like", () => {
+    expect(
+      isDevelopmentBypassEnabled("BYPASS", { NODE_ENV: "development", APP_ENV: "production", BYPASS: "true" }),
+    ).toBe(false);
+    expect(isDevelopmentBypassEnabled("BYPASS", { DEPLOY_ENV: "prod", BYPASS: "1" })).toBe(false);
+  });
+});
diff --git a/frontend/src/server/security/runtime-env.ts b/frontend/src/server/security/runtime-env.ts
new file mode 100644
index 0000000..8de0277
--- /dev/null
+++ b/frontend/src/server/security/runtime-env.ts
@@ -0,0 +1,87 @@
+/**
+ * Shared "is this a production-like runtime?" predicate for security-sensitive
+ * branches.
+ *
+ * Why this exists: several independent security controls (admin auth local
+ * bypass, plaintext password-reset token echo, `Secure` session cookie, SNS
+ * signature verification skip) each used to test `process.env.NODE_ENV !==
+ * "production"` on their own. `NODE_ENV` is a *build-time* signal for
+ * bundlers, not a deployment signal: a container started with a missing or
+ * overridden `NODE_ENV` (or a platform that only sets `APP_ENV` /
+ * `DEPLOY_ENV` / `VERCEL_ENV`) silently re-enables *all* of those bypasses at
+ * once. That single point of failure is worth an unauthenticated admin
+ * console plus arbitrary account takeover via the echoed reset token.
+ *
+ * The multi-variable check below mirrors the stricter predicate this codebase
+ * already used for the Stripe live/test key guard in
+ * `@/server/billing/providers` so security branches and billing branches agree
+ * on what "production" means. That module and
+ * `@/server/operations/production-readiness` now import from here instead of
+ * carrying their own copies.
+ *
+ * Two predicates live here because there are genuinely two questions:
+ *
+ * - `isProductionLikeRuntime` — "may a security bypass be open?" Staging is
+ *   NOT production-like here: staging is where the local admin bypass and the
+ *   echoed reset token are still useful.
+ * - `isProductionLikeDeployment` — "is this a real deployment?" Staging IS
+ *   included, because infrastructure posture checks (MySQL instead of SQLite,
+ *   a real notification provider, object storage) must hold on staging too.
+ *
+ * Note: `@/server/storage/object-storage` deliberately keeps its own local
+ * variant of the second predicate; see the comment there.
+ */
+
+export type RuntimeEnv = Record<string, string | undefined>;
+
+const PRODUCTION_LIKE_RUNTIME_VALUES = new Set(["production", "prod"]);
+
+/**
+ * Environment variables consulted, in no particular order. Any one of them
+ * reading `production`/`prod` marks the runtime production-like (fail-closed:
+ * it takes only one signal to enable protections, and all of them to disable).
+ */
+const RUNTIME_ENV_KEYS = ["NODE_ENV", "APP_ENV", "DEPLOY_ENV", "VERCEL_ENV", "RUNTIME_ENV"] as const;
+
+export function isProductionLikeRuntime(env: RuntimeEnv = process.env): boolean {
+  return RUNTIME_ENV_KEYS.some((key) =>
+    PRODUCTION_LIKE_RUNTIME_VALUES.has((env[key] ?? "").trim().toLowerCase()),
+  );
+}
+
+const PRODUCTION_LIKE_DEPLOYMENT_VALUES = new Set(["production", "prod", "staging"]);
+
+/**
+ * Wider predicate for infrastructure-posture checks (worker preflight, object
+ * storage, production readiness): staging counts as a real deployment, so it
+ * must satisfy the same "no SQLite, no file-based notification provider"
+ * requirements as production. Do NOT use this to gate an auth bypass — use
+ * `isProductionLikeRuntime` for that.
+ */
+export function isProductionLikeDeployment(env: RuntimeEnv = process.env): boolean {
+  return RUNTIME_ENV_KEYS.some((key) =>
+    PRODUCTION_LIKE_DEPLOYMENT_VALUES.has((env[key] ?? "").trim().toLowerCase()),
+  );
+}
+
+/**
+ * True when an explicit opt-in flag is turned on. Only `1`, `true`, `yes` and
+ * `on` count — an unset, empty, or unrecognised value is off. Use this for
+ * every development-only escape hatch so the default is always "closed".
+ */
+export function isFlagEnabled(rawValue: string | undefined): boolean {
+  const normalized = (rawValue ?? "").trim().toLowerCase();
+  return normalized === "1" || normalized === "true" || normalized === "yes" || normalized === "on";
+}
+
+/**
+ * True only when the runtime is *not* production-like AND the named flag is
+ * explicitly enabled. This is the shape every local-only security bypass in
+ * this codebase should take: two independent conditions, both defaulting to
+ * the safe answer, so neither a missing `NODE_ENV` nor a stray env var alone
+ * can open the hole.
+ */
+export function isDevelopmentBypassEnabled(flagName: string, env: RuntimeEnv = process.env): boolean {
+  if (isProductionLikeRuntime(env)) return false;
+  return isFlagEnabled(env[flagName]);
+}

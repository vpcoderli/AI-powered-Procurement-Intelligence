    "db:mysql:smoke": "tsx scripts/mysql-smoke.ts",
    "db:mysql:import-sqlite": "tsx scripts/import-sqlite-to-mysql.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "demo:prepare": "tsx scripts/demo-readiness.ts",
    "demo:check": "tsx scripts/demo-readiness.ts --check-only",
    "demo:smoke": "tsx scripts/demo-smoke.ts",
    "demo:browser-evidence": "tsx scripts/demo-browser-evidence.ts",
    "db:migrate-saved-bids": "tsx scripts/migrate-saved-bids.ts",
    "auth:reset-admin": "tsx scripts/reset-admin-password.ts",

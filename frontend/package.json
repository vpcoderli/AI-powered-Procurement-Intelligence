    "@sendgrid/mail": "^8.1.4",
    "@sentry/nextjs": "^9.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.11.0",
    "mysql2": "^3.22.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",

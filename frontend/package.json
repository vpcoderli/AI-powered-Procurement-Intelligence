    "ops:production:check": "tsx scripts/production-readiness-check.ts",
    "ops:launch-handoff": "tsx scripts/launch-handoff.ts",
    "crawler:once": "tsx scripts/run-crawler-once.ts",
    "worker:crawler": "tsx scripts/crawler-worker.ts",
    "worker:crawler:check": "tsx scripts/crawler-worker.ts --check",
    "worker:events": "tsx scripts/event-worker.ts",
    "worker:events:check": "tsx scripts/event-worker.ts --check",
    "worker:notifications": "tsx scripts/notification-worker.ts",
    "worker:notifications:check": "tsx scripts/notification-worker.ts --check",
    "workers:check": "npm run worker:crawler:check && npm run worker:events:check && npm run worker:notifications:check",
    "source:health:check": "tsx scripts/source-health-check.ts",
    "source:health:report": "tsx scripts/source-health-report.ts",
    "source:health:evidence": "tsx scripts/source-health-evidence.ts",
    "source:health:triage": "tsx scripts/source-health-triage.ts",
    "source:health:access-review": "tsx scripts/source-health-access-review.ts",
    "source:health:ops": "tsx scripts/source-health-check.ts --all --timeout-ms 10000 --inspect-body --write-snapshot --report-only",
    "source:health:scheduled": "npm run source:health:ops",
    "secrets:scan": "tsx scripts/secrets-scan.ts",
    "risk:check": "tsx scripts/risk-check.ts && npm run secrets:scan && npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.906.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@base-ui/react": "^1.4.1",
